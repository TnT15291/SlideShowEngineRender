{
  "id": "modern-teal-01",
  "version": 1,
  "name": "Modern Teal",
  "tier": "smart_lite",
  "libraryTheme": "modern_teal",
  "layoutPresets": {
    "edge_soft": {
      "radius": 16,
      "border": 0,
      "shadow": false
    }
  },
  "looks": {
    "breath_quote": {
      "intent": "the recurring quiet beat, softened away from the opening it shares a page with",
      "layout": "full_bleed_quote",
      "photoTreatment": {
        "saturation": 0.9,
        "brightness": 0.03
      }
    },
    "full_bleed_quote_edge": {
      "intent": "the full-bleed quote beat — a frame would render nothing over a full bleed, so the type and the grade carry it",
      "layout": "full_bleed_quote",
      "layoutOverrides": {
        "textSlots": {
          "quote": {
            "sizePx": 70,
            "y": 770,
            "height": 232
          }
        }
      },
      "photoTreatment": {
        "contrast": 1.06,
        "saturation": 1.04
      }
    },
    "two_photo_story_edge": {
      "intent": "the story pair pushed out to both edges and separated by a single hairline gutter — no margin, no ornament",
      "layout": "two_photo_story",
      "frame": "edge_soft",
      "layoutOverrides": {
        "photoSlots": {
          "portrait": { "x": 40, "y": 100, "width": 560, "height": 700 },
          "wide": { "x": 620, "y": 100, "width": 1260, "height": 700 }
        }
      }
    },
    "duo_tinted_spread_edge": {
      "intent": "the pair run nearly edge to edge with one thin gutter and nothing else",
      "layout": "duo_tinted_spread",
      "frame": "edge_soft",
      "layoutOverrides": {
        "photoSlots": {
          "left": { "x": 30, "y": 230, "width": 910, "height": 600 },
          "right": { "x": 970, "y": 230, "width": 910, "height": 600 }
        }
      }
    },
    "three_photo_row_edge": {
      "intent": "the three-photo row, wearing the recipe's edge_soft frame",
      "layout": "three_photo_row",
      "frame": "edge_soft",
      "layoutOverrides": {
        "photoSlots": {
          "left": { "x": 70, "y": 350, "width": 590, "height": 460 },
          "centre": { "x": 680, "y": 280, "width": 560, "height": 540 },
          "right": { "x": 1260, "y": 220, "width": 590, "height": 620 }
        }
      }
    },
    "collage_cluster_text_edge": {
      "intent": "the cluster squared up to a single grid — two equal stills at the left, one tall frame beside them, all four edges flush",
      "layout": "collage_cluster_text",
      "frame": "edge_soft",
      "layoutOverrides": {
        "photoSlots": {
          "tl": { "x": 20, "y": 60, "width": 560, "height": 440 },
          "bl": { "x": 20, "y": 540, "width": 560, "height": 440 },
          "hero": { "x": 620, "y": 60, "width": 560, "height": 920 }
        }
      }
    },
    "paper_collage_edge": {
      "intent": "the layered paper collage, wearing the recipe's edge_soft frame",
      "layout": "paper_collage",
      "frame": "edge_soft"
    },
    "closing_names_edge": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 116,
            "y": 412
          },
          "date": {
            "sizePx": 32,
            "y": 662
          }
        }
      }
    },
    "p2_offset_portrait": {
      "intent": "Phase 2 adoption of offset_portrait_hero for s83_gallery_matte.",
      "layout": "offset_portrait_hero",
      "frame": "edge_soft",
      "layoutOverrides": {
        "photoSlots": {
          "hero": {
            "x": 130,
            "y": 120,
            "width": 1240,
            "height": 900
          }
        }
      }
    },
    "p2_inset_card": {
      "intent": "Phase 2 adoption of inset_card_hero for s84_photo_duo.",
      "layout": "inset_card_hero",
