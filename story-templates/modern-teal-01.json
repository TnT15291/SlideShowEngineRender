        "photoSlots": {
          "inset": {
            "x": 1240,
            "y": 630,
            "width": 480,
            "height": 370
          }
        }
      }
    },
    "p2_diagonal_trio": {
      "intent": "Phase 2 adoption of diagonal_staircase_trio for s85_arch_trio.",
      "layout": "diagonal_staircase_trio",
      "frame": "edge_soft",
      "layoutOverrides": {
        "photoSlots": {
          "top": {
            "x": 70,
            "y": 90
          },
          "low": {
            "x": 1190,
            "y": 490
          }
        }
      }
    }
