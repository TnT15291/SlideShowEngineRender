{
  "id": "modern-teal-01",
  "version": 1,
  "name": "Modern Teal",
  "tier": "smart_lite",
  "libraryTheme": "modern_teal",
  "storyArc": {
    "sequence": [
      "space",
      "presence",
      "clarity",
      "motion",
      "quiet",
      "geometry",
      "resonance",
      "forever"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "crossfade",
      "smooth_up",
      "dissolve",
      "smooth_left",
      "none",
      "horz_open",
      "squeeze_h"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 2
    }
  },
  "source": {
    "origin": "original",
    "notes": "Modern minimal, contemporary, lots of whitespace with a 2026 Color-of-the-Year 'Transformative Teal' accent. Clean crisp grade, no overlays. Original recipe."
  },
  "intro": {
    "summary": "Phong cách tối giản hiện đại, nhiều khoảng trắng, điểm nhấn màu teal thời thượng.",
    "photos": "Hợp ảnh prewedding/couple hiện đại, bố cục sạch sẽ, ít chi tiết rườm rà — ảnh chất lượng cao quan trọng vì phong cách rất tối giản.",
    "story": "Phù hợp kể hành trình tình yêu theo hướng hiện đại, tinh gọn — tập trung vào cặp đôi, không đi sâu gia đình hay lễ nghi.",
    "music": "Hợp nhạc piano/hiện đại, điềm tĩnh, tiết tấu chậm, tối giản."
  },
  "fit": {
    "bestFor": [
      "modern_minimal",
      "prewedding",
      "editorial",
      "couple_journey"
    ],
    "minPhotos": 30,
    "idealPhotos": 60
  },
  "musicProfile": {
    "moods": [
      "calm",
      "modern",
      "piano"
    ],
    "energy": "low"
  },
  "pacingVariants": [
    {
      "id": "spacious",
      "maxEnergy": 0.38,
      "durationMultiplier": 1.12
    },
    {
      "id": "balanced",
      "maxEnergy": 0.68,
      "durationMultiplier": 1
    },
    {
      "id": "crisp",
      "maxEnergy": 1,
      "durationMultiplier": 0.86
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "meetingPlace",
      "yearsTogether",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 6000,
      "saturation": 1.06,
      "contrast": 1.05,
      "glow": 0.06
    },
    "audio": {
      "fade_in": 1.5,
      "fade_out": 3,
      "crossfade": 0
    },
    "overlays": [],
    "fonts": {
      "title": "fonts/JosefinSans-Regular.ttf",
      "heading": "fonts/Montserrat-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#F3F1EC",
      "ink": "#1C2B30",
      "brown": "#1C2B30",
      "white": "#FFFFFF"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 5,
      "calmSceneSec": 6,
      "buildSceneSec": 4,
      "montageSec": 10,
      "closingSec": 7.5
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "crossfade",
          "duration": 0.5
        },
        {
          "type": "horz_open",
          "duration": 0.45
        },
        {
          "type": "squeeze_h",
          "duration": 0.45
        }
      ],
      "calm": {
        "type": "smooth_up",
        "duration": 0.6
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.5
      },
      "peak": {
        "type": "smooth_left",
        "duration": 0.4
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore",
        "skinFrac"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 75
    }
  },
