    {
      "id": "s13_closing",
      "effect": "layer_scene",
      "durationRole": "closing",
      "transitionRole": "final",
      "photoSlots": [],
      "text": {
        "names": "{{bride}} & {{groom}}",
        "date": "{{location}} · {{date}}"
      },
      "look": "closing_names_halo"
    }
  ]
}
