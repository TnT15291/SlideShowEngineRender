{
  "id": "heritage-ceremony-01",
  "version": 1,
  "name": "Heritage Ceremony",
  "tier": "smart_lite",
  "libraryTheme": "dark_film",
  "looks": {
    "gallery_matte_plate": {
      "intent": "wordless gallery matte beat, wearing this recipe's own frame",
      "layout": "gallery_matte_hero",
      "frame": {
        "radius": 0,
        "border": 5,
        "borderColor": "#C9A86A"
      },
      "photoTreatment": {
        "saturation": 0.92
      }
    },
    "magazine_page_turn_plate": {
      "intent": "wordless magazine page turn beat, wearing this recipe's own frame",
      "layout": "magazine_page_turn",
      "frame": {
        "radius": 0,
        "border": 5,
        "borderColor": "#C9A86A"
      },
      "photoTreatment": {
        "saturation": 0.92
      }
    },
    "arch_trio_plate": {
      "intent": "wordless arch trio beat, wearing this recipe's own frame",
      "layout": "arch_trio",
      "frame": {
        "radius": 0,
        "border": 5,
        "borderColor": "#C9A86A"
      },
      "photoTreatment": {
        "saturation": 0.92
      }
    }
  },
  "storyArc": {
    "sequence": [
      "invitation",
      "ritual",
      "family",
      "vows",
      "ceremony",
      "banquet",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_slow",
      "dissolve",
      "fade_to_black",
      "none",
      "fade_grays",
      "blur"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "Wedding-day-only template with an antique heirloom mood: deep lacquer, aged gold, formal symmetry and restrained film texture instead of modern white minimalism."
  },
  "intro": {
    "summary": "Không khí cổ kính, sơn mài và ánh vàng cổ điển — dành riêng cho ngày lễ cưới truyền thống.",
    "photos": "Hợp ảnh lễ cưới truyền thống/lễ gia tiên, nghi thức, không gian tiệc cưới trang trọng — không cần ảnh prewedding hay hẹn hò trước đó.",
    "story": "Phù hợp video chỉ tập trung vào NGÀY LỄ: rước dâu, nghi thức gia tiên, lời thề, lễ cưới, tiệc đãi khách — mang màu sắc truyền thống, trang nghiêm.",
    "music": "Hợp nhạc mang âm hưởng truyền thống, giao hưởng trang nghiêm, ấm áp, tiết tấu chậm đến vừa."
  },
  "fit": {
    "bestFor": [
      "ceremony_only",
      "traditional_wedding",
      "heritage",
      "family",
      "banquet"
    ],
    "minPhotos": 24,
    "idealPhotos": 55
  },
  "musicProfile": {
    "moods": [
      "traditional",
      "orchestral",
      "solemn",
      "warm"
    ],
    "energy": "low_to_medium"
  },
  "pacingVariants": [
    {
      "id": "ritual",
      "maxEnergy": 0.35,
      "durationMultiplier": 1.18
    },
    {
      "id": "heirloom",
      "maxEnergy": 0.68,
      "durationMultiplier": 1
    },
    {
      "id": "banquet",
      "maxEnergy": 1,
      "durationMultiplier": 0.88
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 4800,
      "saturation": 0.9,
      "contrast": 1.1,
      "grain": 7,
      "vignette": true,
      "glow": 0.04,
      "lut": "assets/luts/moody_earth_01.cube"
    },
    "audio": {
      "fade_in": 2.5,
      "fade_out": 4,
      "crossfade": 0
    },
    "overlays": [],
    "fonts": {
      "title": "fonts/AlexBrush-Regular.ttf",
      "heading": "fonts/YesevaOne-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#170F0B",
      "ink": "#E7D4A8",
      "brown": "#8E2F27",
      "white": "#F7EBD4"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 6.2,
      "calmSceneSec": 8,
      "buildSceneSec": 5,
      "montageSec": 10,
      "closingSec": 9
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "fade_slow",
          "duration": 1
        },
        {
          "type": "fade_grays",
          "duration": 1
        },
        {
          "type": "blur",
          "duration": 0.9
        }
      ],
      "calm": {
        "type": "fade_slow",
        "duration": 1.2
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.9
      },
      "peak": {
        "type": "fade_to_black",
        "duration": 0.7
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 58
    }
  },
  "scenes": [
    {
      "id": "s01_invite",
      "effect": "dark_feather",
      "durationRole": "calm",
      "transitionRole": "calm",
      "captionPattern": [
        "HỶ SỰ · {{bride}} & {{groom}}",
        "LỄ CƯỚI · {{bride}} & {{groom}}"
      ],
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "landscape",
          "quality": "best"
        }
      ]
    },
    {
      "id": "s02_details",
      "effect": "layer_scene",
      "layout": "paper_collage",
      "durationRole": "normal",
      "transitionRole": "memory",
      "photoSlots": [
        {
          "slot": "back",
          "orient": "any",
          "quality": "good"
        },
        {
          "slot": "centre",
          "orient": "portrait",
          "quality": "best"
        },
        {
          "slot": "front",
          "orient": "any",
          "quality": "good"
        }
      ],
      "text": {
        "heading": [
          "Gia lễ · {{date}}",
          "Ngày trọng đại · {{date}}"
        ]
      },
      "repeatable": {
        "maxRepeats": 3,
        "variants": [
          {
            "text": {
              "heading": "Bên nhau"
            }
          },
          {
            "text": {
              "heading": "Ngày chung đôi"
            }
          }
        ]
      }
    },
    {
      "id": "s02c_family_portraits",
      "effect": "layer_scene",
      "layout": "invitation_row",
      "durationRole": "normal",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "p1",
          "orient": "any",
          "quality": "good"
        },
        {
          "slot": "p2",
          "orient": "any",
          "quality": "good"
        },
        {
          "slot": "p3",
          "orient": "any",
          "quality": "good"
        },
        {
          "slot": "p4",
          "orient": "any",
          "quality": "good"
        }
      ],
      "text": {
        "names": "{{bride}} & {{groom}}",
        "invite": [
          "Trân trọng kính mời đến chung vui.",
          "Kính mời gia đình, bạn bè đến chung vui."
        ]
      }
    },
    {
      "id": "s02b_lacquer_heirloom",
      "effect": "video_background",
      "background": "assets/backgrounds/editorial/midnight-lacquer-aged-gold.png",
      "durationRole": "calm",
      "transitionRole": "default",
      "captionPattern": [
        "Nếp nhà trao lại · Duyên lành tiếp nối.",
