{
  "id": "heritage-ceremony-01",
  "version": 1,
  "name": "Heritage Ceremony",
  "tier": "smart_lite",
  "libraryTheme": "dark_film",
  "layoutPresets": {
    "lacquer_frame": {
      "radius": 0,
      "border": 9,
      "borderColor": "#8C3A2E",
      "shadow": true
    }
  },
  "looks": {
    "paper_collage_lacquer": {
      "intent": "the layered paper collage, wearing the recipe's lacquer_frame frame",
      "layout": "paper_collage",
      "frame": "lacquer_frame"
    },
    "invitation_row_lacquer": {
      "intent": "the invitation row, wearing the recipe's lacquer_frame frame",
      "layout": "invitation_row",
      "frame": "lacquer_frame"
    },
    "three_photo_row_lacquer": {
      "intent": "the three-photo row, wearing the recipe's lacquer_frame frame",
      "layout": "three_photo_row",
      "frame": "lacquer_frame"
    },
    "duo_tinted_spread_lacquer": {
      "intent": "the tinted two-photo spread, wearing the recipe's lacquer_frame frame",
      "layout": "duo_tinted_spread",
      "frame": "lacquer_frame"
    },
    "closing_names_lacquer": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 134,
            "y": 395
          },
          "date": {
            "sizePx": 38,
            "y": 655
          }
        }
      }
    },
    "p2_offset_portrait": {
      "intent": "Phase 2 adoption of offset_portrait_hero for s83_gallery_matte.",
      "layout": "offset_portrait_hero",
      "frame": "lacquer_frame",
      "photoTreatment": {
        "saturation": 1.06,
        "contrast": 1.05
      },
      "layoutOverrides": {
        "photoSlots": {
          "hero": {
            "x": 130,
            "y": 100,
            "width": 1240,
            "height": 900
          }
        }
      }
    },
    "p2_overlap_duo": {
      "intent": "Phase 2 adoption of overlap_stack_duo for s84_photo_duo.",
      "layout": "overlap_stack_duo",
      "photoTreatment": {
        "saturation": 1.06,
        "contrast": 1.05
      },
      "layoutOverrides": {
        "photoSlots": {
          "back": {
            "x": 210
          },
          "front": {
            "x": 920,
            "y": 400,
            "rotation": -4
          }
        }
      }
    },
    "p2_diagonal_trio": {
      "intent": "Phase 2 adoption of diagonal_staircase_trio for s85_arch_trio.",
      "layout": "diagonal_staircase_trio",
      "frame": "lacquer_frame",
      "photoTreatment": {
        "saturation": 1.06,
        "contrast": 1.05
      },
      "layoutOverrides": {
        "photoSlots": {
          "top": {
            "x": 70
          },
          "low": {
            "x": 1190
          }
        }
      }
    }
  },
  "storyArc": {
    "sequence": [
      "invitation",
      "ritual",
      "family",
      "vows",
      "ceremony",
      "banquet",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_slow",
      "dissolve",
      "fade_to_black",
      "none",
      "fade_grays",
      "blur"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "Wedding-day-only template with an antique heirloom mood: deep lacquer, aged gold, formal symmetry and restrained film texture instead of modern white minimalism."
  },
  "intro": {
    "summary": "Không khí cổ kính, sơn mài và ánh vàng cổ điển — dành riêng cho ngày lễ cưới truyền thống.",
    "photos": "Hợp ảnh lễ cưới truyền thống/lễ gia tiên, nghi thức, không gian tiệc cưới trang trọng — không cần ảnh prewedding hay hẹn hò trước đó.",
    "story": "Phù hợp video chỉ tập trung vào NGÀY LỄ: rước dâu, nghi thức gia tiên, lời thề, lễ cưới, tiệc đãi khách — mang màu sắc truyền thống, trang nghiêm.",
    "music": "Hợp nhạc mang âm hưởng truyền thống, giao hưởng trang nghiêm, ấm áp, tiết tấu chậm đến vừa."
  },
  "fit": {
    "bestFor": [
      "ceremony_only",
      "traditional_wedding",
      "heritage",
      "family",
      "banquet"
    ],
    "minPhotos": 24,
    "idealPhotos": 55
  },
  "musicProfile": {
    "moods": [
      "traditional",
      "orchestral",
      "solemn",
      "warm"
    ],
    "energy": "low_to_medium"
  },
  "pacingVariants": [
    {
      "id": "ritual",
      "maxEnergy": 0.35,
      "durationMultiplier": 1.18
    },
    {
      "id": "heirloom",
      "maxEnergy": 0.68,
      "durationMultiplier": 1
    },
    {
      "id": "banquet",
      "maxEnergy": 1,
      "durationMultiplier": 0.88
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 4800,
      "saturation": 0.9,
      "contrast": 1.1,
      "grain": 7,
      "vignette": true,
      "glow": 0.04,
      "lut": "assets/luts/moody_earth_01.cube"
    },
    "audio": {
      "fade_in": 2.5,
      "fade_out": 4,
      "crossfade": 0
    },
    "overlays": [],
    "fonts": {
      "title": "fonts/AlexBrush-Regular.ttf",
      "heading": "fonts/YesevaOne-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#170F0B",
      "ink": "#E7D4A8",
      "brown": "#8E2F27",
      "white": "#F7EBD4"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 6.2,
      "calmSceneSec": 8,
      "buildSceneSec": 5,
      "montageSec": 10,
      "closingSec": 9
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "fade_slow",
          "duration": 1
        },
        {
          "type": "fade_grays",
          "duration": 1
        },
        {
          "type": "blur",
          "duration": 0.9
        }
      ],
      "calm": {
        "type": "fade_slow",
        "duration": 1.2
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.9
      },
      "peak": {
        "type": "fade_to_black",
        "duration": 0.7
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 58
    }
  },
  "scenes": [
    {
      "id": "s01_invite",
      "effect": "dark_feather",
      "durationRole": "calm",
      "transitionRole": "calm",
      "captionPattern": [
        "HỶ SỰ · {{bride}} & {{groom}}",
        "LỄ CƯỚI · {{bride}} & {{groom}}"
      ],
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "landscape",
          "quality": "best"
        }
      ]
    },
    {
      "id": "s02_details",
      "effect": "layer_scene",
      "durationRole": "normal",
      "transitionRole": "memory",
