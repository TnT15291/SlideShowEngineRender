      "photoSlots": [
        {
          "slot": "memories",
          "count": 6,
          "orient": "any",
          "quality": "good"
        }
      ],
      "captionPattern": [
        "Hai gia đình · Một niềm vui",
        "Hai họ sum vầy · Một niềm hạnh phúc"
      ],
      "params": {
        "background": "#2B2B32"
      },
      "repeatable": {
        "maxRepeats": 3,
        "variants": [
