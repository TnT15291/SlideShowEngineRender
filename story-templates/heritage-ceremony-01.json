        {
          "slot": "back",
          "orient": "any",
          "quality": "good"
        },
        {
          "slot": "centre",
          "orient": "portrait",
          "quality": "best"
        },
        {
          "slot": "front",
          "orient": "any",
          "quality": "good"
        }
      ],
      "text": {
        "heading": [
          "Gia lễ · {{date}}",
          "Ngày trọng đại · {{date}}"
        ]
      },
      "repeatable": {
        "maxRepeats": 3,
        "variants": [
          {
            "text": {
              "heading": "Bên nhau"
            }
          },
          {
            "text": {
              "heading": "Ngày chung đôi"
            }
          }
