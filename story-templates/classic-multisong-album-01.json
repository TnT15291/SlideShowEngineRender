{
  "id": "classic-multisong-album-01",
  "version": 1,
  "name": "Classic Multisong Wedding Album",
  "tier": "smart_lite",
  "libraryTheme": "white_weddings",
  "storyArc": {
    "sequence": [
      "opening",
      "portraits",
      "together",
      "memories",
      "celebration",
      "forever",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_slow",
      "dissolve",
      "crossfade",
      "slice_left",
      "circle_open",
      "none"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 4,
      "peak": 3
    }
  },
  "source": {
    "origin": "reference_adaptation",
    "notes": "Adapted from Tuan Tien Slideshow.mp4: an 18:37 classic wedding slideshow using five romantic/pop songs, portrait cards over blurred backdrops, photo stacks, grids, page turns, white flashes and checker mosaics. Designed for long playlists and roughly 140-220 photographs."
  },
  "intro": {
    "summary": "Album cưới cổ điển dạng phim dài, nối nhiều bài nhạc và thay đổi nhịp theo từng chương.",
    "photos": "Phù hợp bộ ảnh lớn 140–220 tấm, gồm ảnh chân dung, ngoại cảnh, đời thường, chi tiết và ảnh cưới.",
    "story": "Mở đầu nhẹ nhàng, đi qua chân dung và kỷ niệm, tăng tốc ở chương vui, rồi kết bằng lời hứa cưới.",
    "music": "Playlist 4–6 bài, tổng khoảng 14–20 phút; acoustic/ballad ở đầu và cuối, pop vừa hoặc nhanh ở chương celebration."
  },
  "fit": {
    "bestFor": [
      "wedding",
      "pre_wedding",
      "large_album",
      "multisong",
      "classic_slideshow"
    ],
    "minPhotos": 120,
    "idealPhotos": 190
  },
  "musicProfile": {
    "moods": [
      "romantic",
      "nostalgic",
      "warm",
      "celebratory"
    ],
    "energy": "low_to_high_to_low"
  },
  "pacingVariants": [
    {
      "id": "vow",
      "maxEnergy": 0.36,
      "durationMultiplier": 1.12
    },
    {
      "id": "memory",
      "maxEnergy": 0.66,
      "durationMultiplier": 1
    },
    {
      "id": "celebration",
      "maxEnergy": 1,
      "durationMultiplier": 0.86
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 5550,
      "saturation": 1.03,
      "contrast": 1.04,
      "glow": 0.1,
      "grain": 1
    },
    "audio": {
      "fade_in": 1.5,
      "fade_out": 4,
      "crossfade": 2
    },
    "overlays": [],
    "fonts": {
      "title": "fonts/Allura-Regular.ttf",
      "heading": "fonts/CormorantGaramond-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#F7F3EC",
      "white": "#FFFDFC",
      "ink": "#262422",
      "warm": "#B9906A"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 5.2,
      "calmSceneSec": 6.8,
      "buildSceneSec": 4.2,
      "montageSec": 8.5,
      "closingSec": 9
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "dissolve",
          "duration": 0.75
        },
        {
          "type": "fade_slow",
          "duration": 0.9
        },
        {
          "type": "slice_left",
          "duration": 0.65
        }
      ],
      "calm": {
        "type": "fade_slow",
        "duration": 1.05
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.85
      },
      "peak": {
        "type": "crossfade",
        "duration": 0.5
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 74
    }
  },
  "scenes": [
