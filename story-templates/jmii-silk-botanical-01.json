      "layoutOverrides": {
        "photoSlots": {
          "hero": {
            "x": 130,
            "y": 90,
            "width": 700,
            "height": 900,
            "suggestedAnimation": "fade"
          }
        }
      },
      "frame": "arch"
    },
    "moment_still": {
      "intent": "a held beat: a taller portrait, slightly desaturated, entering more slowly",
      "layout": "text_left_photo_right",
      "layoutOverrides": {
        "photoSlots": {
          "hero": {
            "x": 1020,
            "y": 60,
            "width": 820,
            "height": 960,
            "suggestedAnimation": "fade"
          }
        }
      },
      "photoTreatment": {
        "saturation": 0.92
      },
      "motion": {
        "stagger": 0.14
      }
    },
    "arch_gallery": {
      "intent": "three arched portraits in a row",
      "layout": "arch_trio",
      "frame": "arch"
    },
    "duo_arch": {
      "intent": "two arched portraits side by side",
      "layout": "photo_duo",
      "frame": "arch"
    },
    "quiet_quote": {
      "intent": "wordless recurrence: one photograph full bleed, softened",
      "layout": "full_bleed_quote",
      "photoTreatment": {
        "saturation": 0.88
      }
    },
    "quiet_matte": {
      "intent": "the other wordless recurrence: one photograph matted on cream",
      "layout": "gallery_matte_hero",
      "photoTreatment": {
        "saturation": 0.92
      }
    }
  },
