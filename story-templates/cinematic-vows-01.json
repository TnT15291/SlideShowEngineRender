{
  "id": "cinematic-vows-01",
  "version": 1,
  "name": "Cinematic Vows",
  "tier": "smart_lite",
  "libraryTheme": "teal_orange_editorial",
  "storyArc": {
    "sequence": [
      "cold_open",
      "anticipation",
      "first_look",
      "vows",
      "rings",
      "kiss",
      "celebration",
      "epilogue"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_to_black",
      "crossfade",
      "dissolve",
      "none",
      "blur"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 2
    }
  },
  "source": {
    "origin": "original",
    "notes": "A film-trailer treatment focused tightly on wedding-day anticipation, vows and emotional reaction shots, with a controlled teal/orange editorial grade."
  },
  "intro": {
    "summary": "Trailer điện ảnh tập trung vào khoảnh khắc hồi hộp ngày cưới, lời thề và phản ứng cảm xúc, tông teal/cam đặc trưng.",
    "photos": "Hợp ảnh phong cảnh (landscape) nhiều, cận cảnh biểu cảm lúc trao nhẫn/thề nguyện; ảnh cần sắc nét vì đây là trọng tâm video.",
    "story": "Dành cho video tập trung sát vào NGÀY CƯỚI: hồi hộp chuẩn bị, gặp mặt lần đầu, lời thề, trao nhẫn, nụ hôn, tiệc mừng — không kể chuyện tình trước đó.",
    "music": "Hợp nhạc giao hưởng điện ảnh, cảm xúc dâng trào, năng lượng trung bình đến cao, có cao trào rõ rệt."
  },
  "fit": {
    "bestFor": [
      "cinematic",
      "vows",
      "wedding_day",
      "emotional",
      "landscape_heavy"
    ],
    "minPhotos": 22,
    "idealPhotos": 52
  },
  "musicProfile": {
    "moods": [
      "cinematic",
      "orchestral",
      "emotional"
    ],
    "energy": "medium_to_high"
  },
  "pacingVariants": [
    {
      "id": "arthouse",
      "maxEnergy": 0.4,
      "durationMultiplier": 1.14
    },
    {
      "id": "feature",
      "maxEnergy": 0.72,
      "durationMultiplier": 1
    },
    {
      "id": "trailer",
      "maxEnergy": 1,
      "durationMultiplier": 0.8
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "lut": "assets/luts/teal_orange_01.cube",
      "contrast": 1.05,
      "saturation": 1.01,
      "grain": 3,
      "glow": 0.05
    },
    "audio": {
      "fade_in": 1.5,
      "fade_out": 4,
      "crossfade": 0
    },
    "overlays": [],
    "fonts": {
      "title": "fonts/AlexBrush-Regular.ttf",
      "heading": "fonts/PlayfairDisplay.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#12191C",
      "ink": "#F2EFE9",
      "brown": "#D96F32",
      "white": "#FBFCFB"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 5.2,
      "calmSceneSec": 7.2,
      "buildSceneSec": 4,
      "montageSec": 9.5,
      "closingSec": 8.5
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "crossfade",
          "duration": 0.5
        },
        {
          "type": "dissolve",
          "duration": 0.5
        },
        {
          "type": "blur",
          "duration": 0.45
        }
      ],
      "calm": {
        "type": "dissolve",
        "duration": 0.8
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.8
      },
      "peak": {
        "type": "fade_to_black",
        "duration": 0.45
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "emotionScore",
        "heroScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 58
    }
  },
  "scenes": [
