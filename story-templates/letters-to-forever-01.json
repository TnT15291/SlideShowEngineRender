{
  "id": "letters-to-forever-01",
  "version": 1,
  "name": "Letters to Forever",
  "tier": "smart_lite",
  "libraryTheme": "white_weddings",
  "storyArc": {
    "sequence": [
      "dear_you",
      "first_letter",
      "chapters",
      "proposal",
      "vows",
      "postscript",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_slow",
      "dissolve",
      "crossfade",
      "none",
      "reveal_left"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 2,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "An intimate epistolary template built like exchanged letters, with paper collage pages and handwritten-feeling English accents over Vietnamese-safe body copy."
  },
  "intro": {
    "summary": "Kể chuyện tình như những lá thư trao nhau — trang giấy collage, chữ viết tay ấm áp.",
    "photos": "Hợp đám cưới nhỏ, thân mật, ảnh ít nhưng có chiều sâu cảm xúc (20–48) — không cần số lượng lớn.",
    "story": "Phù hợp cặp đôi muốn kể chuyện tình theo hướng nội tâm, riêng tư — như những bức thư, tập trung lời thề và khoảnh khắc thân mật thay vì đại tiệc.",
    "music": "Hợp nhạc piano mộc mạc, gần gũi, nhẹ nhàng, tiết tấu rất chậm."
  },
  "fit": {
    "bestFor": [
      "intimate",
      "vows",
      "letters",
      "editorial",
      "small_wedding"
    ],
    "minPhotos": 20,
    "idealPhotos": 48
  },
  "musicProfile": {
    "moods": [
      "piano",
      "intimate",
      "gentle"
    ],
    "energy": "low"
  },
  "pacingVariants": [
    {
      "id": "whisper",
      "maxEnergy": 0.35,
      "durationMultiplier": 1.18
    },
    {
      "id": "reading",
      "maxEnergy": 0.65,
      "durationMultiplier": 1
    },
    {
      "id": "montage",
      "maxEnergy": 1,
      "durationMultiplier": 0.88
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 5500,
      "saturation": 0.98,
      "contrast": 1.02,
      "glow": 0.08,
      "grain": 2
    },
    "audio": {
      "fade_in": 2.2,
      "fade_out": 4,
      "crossfade": 0
    },
    "overlays": [],
    "fonts": {
      "title": "fonts/Allura-Regular.ttf",
      "heading": "fonts/CormorantGaramond-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#FAF3E8",
      "ink": "#34302D",
      "brown": "#856E58",
      "white": "#FFFDFC"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 6,
      "calmSceneSec": 8,
      "buildSceneSec": 5,
      "montageSec": 10,
      "closingSec": 9
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "dissolve",
          "duration": 0.85
        },
        {
          "type": "fade_slow",
          "duration": 0.9
        },
        {
          "type": "reveal_left",
          "duration": 0.7
        }
      ],
      "calm": {
        "type": "fade_slow",
        "duration": 1.15
      },
      "memory": {
        "type": "dissolve",
        "duration": 1
      },
      "peak": {
        "type": "crossfade",
        "duration": 0.6
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 72
    }
  },
  "scenes": [
    {
      "id": "s01_dear",
      "effect": "layer_scene",
      "layout": "welcome_title_page",
      "durationRole": "calm",
      "transitionRole": "calm",
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "portrait",
          "quality": "best"
        }
      ],
      "text": {
        "eyebrow": "DEAR YOU,",
        "names": "{{bride}} & {{groom}}",
        "date": "Một lá thư gửi đến ngày mai"
      }
    },
    {
      "id": "s02_first",
      "effect": "layer_scene",
      "layout": "paper_collage",
      "durationRole": "normal",
      "transitionRole": "memory",
      "photoSlots": [
        {
          "slot": "back",
          "orient": "any",
          "quality": "good"
        },
        {
          "slot": "centre",
          "orient": "portrait",
          "quality": "best"
        },
        {
          "slot": "front",
          "orient": "any",
          "quality": "good"
        }
      ],
      "text": {
        "heading": [
          "Lá thư đầu tiên",
          "Trang thư mở đầu"
        ]
      },
      "repeatable": {
        "maxRepeats": 3,
        "variants": [
          {
            "text": {
              "heading": "Nét chữ đầu tiên"
            }
          },
          {
            "text": {
              "heading": "Dòng thư thứ hai"
            }
          }
