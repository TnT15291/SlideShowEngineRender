    "bestFor": [
      "prewedding",
      "candid",
      "soft_romance",
      "family_warmth",
      "outdoor"
    ],
    "minPhotos": 35,
    "idealPhotos": 70
  },
  "musicProfile": {
    "moods": [
      "romantic",
      "warm",
      "acoustic"
    ],
    "energy": "low_to_medium"
  },
