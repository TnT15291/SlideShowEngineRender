{
  "id": "playful-scrapbook-01",
  "version": 1,
  "name": "Playful Scrapbook",
  "tier": "smart_lite",
  "libraryTheme": "editorial_bold",
  "layoutPresets": {
    "print_border": {
      "radius": 2,
      "border": 20,
      "borderColor": "#FFFFFF",
      "shadow": true
    }
  },
  "looks": {
    "gallery_matte_plate": {
      "intent": "wordless gallery matte beat, wearing this recipe's own frame",
      "layout": "gallery_matte_hero",
      "frame": "print_border"
    },
    "photo_duo_plate": {
      "intent": "wordless photo duo beat, wearing this recipe's own frame",
      "layout": "photo_duo",
      "frame": "print_border"
    },
    "arch_trio_plate": {
      "intent": "wordless arch trio beat, wearing this recipe's own frame",
      "layout": "arch_trio",
      "frame": "print_border"
    },
    "polaroid_scatter_print": {
      "intent": "the scattered prints, wearing the recipe's print_border frame",
      "layout": "polaroid_scatter",
      "frame": "print_border"
    },
    "collage_cluster_text_print": {
      "intent": "the photo cluster beside its paragraph, wearing the recipe's print_border frame",
      "layout": "collage_cluster_text",
      "frame": "print_border"
    },
    "paper_collage_print": {
      "intent": "the layered paper collage, wearing the recipe's print_border frame",
      "layout": "paper_collage",
      "frame": "print_border"
    },
    "two_photo_story_print": {
      "intent": "the portrait-and-wide story pair, wearing the recipe's print_border frame",
      "layout": "two_photo_story",
      "frame": "print_border"
    },
    "journey_duo_print": {
      "intent": "the journey pair, wearing the recipe's print_border frame",
      "layout": "journey_duo",
      "frame": "print_border"
    },
    "polaroid_feature_print": {
      "intent": "the single featured print, wearing the recipe's print_border frame",
      "layout": "polaroid_feature",
      "frame": "print_border"
    },
    "full_bleed_quote_print": {
      "intent": "the full-bleed quote beat — a frame would render nothing over a full bleed, so the type and the grade carry it",
      "layout": "full_bleed_quote",
      "layoutOverrides": {
        "textSlots": {
          "quote": {
            "sizePx": 60,
            "y": 798,
            "height": 206
          }
        }
      },
      "photoTreatment": {
        "saturation": 1.08
      }
    },
    "closing_names_print": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 138,
            "y": 388
          },
          "date": {
            "sizePx": 40,
            "y": 650
          }
        }
      }
    }
  },
  "storyArc": {
    "sequence": [
      "snapshot",
      "wander",
      "laughter",
      "motion",
      "keepsake",
      "spark",
      "colour",
      "forever"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "crossfade",
      "smooth_left",
      "smooth_up",
      "dissolve",
      "none",
      "slice_left",
      "wind_up"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 2
    }
  },
  "source": {
    "origin": "original",
    "notes": "Bright candid scrapbook: polaroids, asymmetric clusters and quick photo sweeps for travel and everyday memories."
  },
  "intro": {
    "summary": "Cuốn sổ tay ảnh vui nhộn — polaroid, cụm ảnh bất đối xứng, những chuyến đi và khoảnh khắc đời thường.",
    "photos": "Cần NHIỀU ảnh (36–80), ưu tiên ảnh candid, ảnh du lịch, ảnh đời thường vui vẻ — càng đa dạng khoảnh khắc càng hợp.",
    "story": "Phù hợp cặp đôi có nhiều kỷ niệm vui, năng động, thích du lịch/khám phá cùng nhau — muốn video vui tươi, ít trang trọng.",
    "music": "Hợp nhạc vui nhộn, pop tươi sáng, tiết tấu vừa đến nhanh."
  },
  "fit": {
    "bestFor": [
      "candid",
      "travel",
      "playful",
      "couple_journey"
    ],
    "minPhotos": 36,
    "idealPhotos": 80
  },
  "musicProfile": {
    "moods": [
      "fun",
      "pop",
      "uplifting"
    ],
    "energy": "medium_to_high"
  },
  "pacingVariants": [
    {
      "id": "easygoing",
      "maxEnergy": 0.38,
      "durationMultiplier": 1.08
    },
    {
      "id": "playful",
      "maxEnergy": 0.68,
      "durationMultiplier": 0.96
    },
    {
      "id": "party",
      "maxEnergy": 1,
      "durationMultiplier": 0.82
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "meetingPlace",
      "yearsTogether"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 6000,
      "saturation": 1.04,
      "contrast": 1.04,
      "glow": 0.04
    },
    "audio": {
      "fade_in": 1,
      "fade_out": 2.5,
      "crossfade": 0
    },
    "overlays": [
      {
        "variant": "sunset",
        "position": "fullscreen",
        "opacity": 0.1,
        "blend": "screen",
        "start": 0
      }
    ],
    "fonts": {
      "title": "fonts/JosefinSans-Regular.ttf",
      "heading": "fonts/PlayfairDisplay.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#FFF5E8",
      "ink": "#2D2630",
      "brown": "#B45F4D",
      "white": "#FFFFFF"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 4.8,
      "calmSceneSec": 5.8,
      "buildSceneSec": 3.8,
      "montageSec": 9.5,
      "closingSec": 7
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "crossfade",
          "duration": 0.5
        },
        {
          "type": "slice_left",
          "duration": 0.4
        },
        {
          "type": "wind_up",
          "duration": 0.4
        }
      ],
      "calm": {
        "type": "dissolve",
        "duration": 0.7
      },
      "memory": {
        "type": "smooth_up",
        "duration": 0.45
      },
      "peak": {
        "type": "smooth_left",
        "duration": 0.35
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "emotionScore",
        "qualityNorm",
        "heroScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 70
    }
  },
