{
  "id": "long-distance-love-01",
  "version": 1,
  "name": "Across the Miles",
  "tier": "smart_lite",
  "libraryTheme": "modern_teal",
  "layoutPresets": {
    "postmark_rule": {
      "radius": 0,
      "border": 12,
      "borderColor": "#2E6F6A",
      "shadow": true
    }
  },
  "looks": {
    "photo_duo_plate": {
      "intent": "the pair set wide and level, two places given exactly the same weight",
      "layout": "photo_duo",
      "frame": "postmark_rule",
      "layoutOverrides": {
        "photoSlots": {
          "left": { "x": 120, "y": 140, "width": 740, "height": 820 },
          "right": { "x": 1060, "y": 140, "width": 740, "height": 820 }
        }
      }
    },
    "journey_story_plate": {
      "intent": "the journey opened out to its widest, the second frame hung low and far off to one side",
      "layout": "journey_duo",
      "layoutOverrides": {
        "photoSlots": {
          "wide": { "x": 600, "y": 70, "width": 1040, "height": 600 },
          "accent": { "x": 1380, "y": 500, "width": 420, "height": 540 }
        },
        "textSlots": {
          "heading": {
            "sizePx": 76
          },
          "caption": {
            "sizePx": 32
          }
        }
      }
    },
    "miles_title_plate": {
      "intent": "restrained chapter title using the recipe heading scale",
      "layout": "polaroid_scatter",
      "layoutOverrides": {
        "photoSlots": {
          "p1": { "x": 70, "y": 200, "width": 530, "height": 530, "rotation": -2 },
          "p2": { "x": 680, "y": 130, "width": 530, "height": 530, "rotation": 3 },
          "p3": { "x": 1290, "y": 200, "width": 530, "height": 530, "rotation": -3 }
        },
        "textSlots": {
          "heading": {
            "sizePx": 76
          }
        }
      }
    },
    "reunion_quote_plate": {
      "intent": "large readable reunion quote over the full-bleed photograph",
      "layout": "full_bleed_quote",
      "layoutOverrides": {
        "textSlots": {
          "quote": {
            "sizePx": 68
          }
        }
      }
    },
    "two_cities_plate": {
      "intent": "two cities held apart at equal size, a deliberate gap of page between them",
      "layout": "duo_tinted_spread",
      "layoutOverrides": {
        "photoSlots": {
          "left": { "x": 70, "y": 290, "width": 780, "height": 540 },
          "right": { "x": 1070, "y": 290, "width": 780, "height": 540 }
        },
        "textSlots": {
          "heading": {
            "sizePx": 72
          }
        }
      }
    },
    "closing_names_postmark": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 130,
            "y": 398
          },
          "date": {
            "sizePx": 36,
            "y": 656
          }
        }
      }
    },
    "p2_offset_portrait": {
      "intent": "Phase 2 adoption of offset_portrait_hero for s83_gallery_matte.",
      "layout": "offset_portrait_hero",
      "frame": "postmark_rule",
      "layoutOverrides": {
        "photoSlots": {
          "hero": {
            "x": 220,
            "y": 100,
            "width": 1240,
            "height": 900
          }
        }
      }
    },
    "p2_overlap_duo": {
      "intent": "Phase 2 adoption of overlap_stack_duo for s84_arch_trio.",
      "layout": "overlap_stack_duo",
      "layoutOverrides": {
        "photoSlots": {
          "front": {
            "x": 820,
            "y": 440,
            "rotation": -2
          }
        }
      }
    },
    "p2_circle_trio": {
      "intent": "Phase 2 adoption of circle_trio_stagger for s85_feature_duo.",
      "layout": "circle_trio_stagger",
      "layoutOverrides": {
        "photoSlots": {
          "p1": {
            "y": 60
          },
          "p2": {
            "y": 300
          },
          "p3": {
            "y": 120
          }
        }
      }
    }
  },
  "storyArc": {
    "sequence": [
      "two_places",
      "first_message",
      "visits",
      "distance",
      "reunion",
      "proposal",
      "wedding",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "crossfade",
      "smooth_left",
      "dissolve",
      "none",
      "wipe_right"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "A clean geographic-feeling story for long-distance couples, moving from two separate places through messages and reunions to one home."
  },
  "intro": {
    "summary": "Câu chuyện tình yêu xa — từ hai nơi cách biệt, qua tin nhắn và những lần đoàn tụ, đến một mái nhà chung.",
    "photos": "Cần ảnh ở nhiều địa điểm khác nhau (thể hiện khoảng cách địa lý), ảnh những lần gặp lại, ảnh du lịch/đi cùng nhau.",
    "story": "Phù hợp cặp đôi từng yêu xa — muốn kể rõ hành trình từ xa cách đến đoàn tụ và về chung một nhà.",
    "music": "Hợp nhạc hiện đại, đầy hy vọng, mang chút chất điện ảnh, tiết tấu vừa."
  },
  "fit": {
    "bestFor": [
      "long_distance",
      "travel",
      "international",
      "couple_journey"
    ],
    "minPhotos": 24,
    "idealPhotos": 60
  },
  "musicProfile": {
    "moods": [
      "hopeful",
      "modern",
      "cinematic"
    ],
    "energy": "medium"
  },
  "pacingVariants": [
    {
      "id": "letters",
      "maxEnergy": 0.38,
      "durationMultiplier": 1.12
    },
    {
      "id": "journey",
      "maxEnergy": 0.7,
      "durationMultiplier": 1
    },
    {
      "id": "reunion",
      "maxEnergy": 1,
      "durationMultiplier": 0.85
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "meetingPlace",
      "yearsTogether",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 6000,
      "saturation": 1.04,
      "contrast": 1.05,
      "glow": 0.05
    },
    "audio": {
      "fade_in": 1.5,
      "fade_out": 3,
      "crossfade": 0
    },
    "overlays": [],
    "fonts": {
      "title": "fonts/Montserrat-Regular.ttf",
      "heading": "fonts/Montserrat-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#F3F1EC",
      "ink": "#16232A",
      "brown": "#2E6F6A",
      "white": "#FFFFFF"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 5.2,
      "calmSceneSec": 6.8,
      "buildSceneSec": 4.2,
      "montageSec": 9.5,
      "closingSec": 8
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "crossfade",
          "duration": 0.55
        },
        {
          "type": "smooth_left",
          "duration": 0.5
        },
        {
          "type": "wipe_right",
          "duration": 0.5
        }
      ],
      "calm": {
        "type": "dissolve",
        "duration": 0.8
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.7
      },
      "peak": {
        "type": "smooth_left",
        "duration": 0.45
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 72
    }
  },
  "scenes": [
