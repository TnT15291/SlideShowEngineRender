      "layout": "magazine_page_turn",
      "frame": {
        "radius": 0,
        "border": 8,
        "borderColor": "#2E6F6A"
      }
    },
    "arch_trio_plate": {
      "intent": "wordless arch trio beat, wearing this recipe's own frame",
      "layout": "arch_trio",
      "frame": {
        "radius": 0,
        "border": 8,
        "borderColor": "#2E6F6A"
      }
    }
