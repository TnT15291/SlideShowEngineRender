  "storyArc": {
    "sequence": [
      "two_places",
      "first_message",
      "visits",
      "distance",
      "reunion",
      "proposal",
      "wedding",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "crossfade",
      "smooth_left",
      "dissolve",
      "none",
      "wipe_right"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "A clean geographic-feeling story for long-distance couples, moving from two separate places through messages and reunions to one home."
  },
  "intro": {
    "summary": "Câu chuyện tình yêu xa — từ hai nơi cách biệt, qua tin nhắn và những lần đoàn tụ, đến một mái nhà chung.",
    "photos": "Cần ảnh ở nhiều địa điểm khác nhau (thể hiện khoảng cách địa lý), ảnh những lần gặp lại, ảnh du lịch/đi cùng nhau.",
    "story": "Phù hợp cặp đôi từng yêu xa — muốn kể rõ hành trình từ xa cách đến đoàn tụ và về chung một nhà.",
    "music": "Hợp nhạc hiện đại, đầy hy vọng, mang chút chất điện ảnh, tiết tấu vừa."
  },
  "fit": {
    "bestFor": [
      "long_distance",
      "travel",
      "international",
      "couple_journey"
    ],
    "minPhotos": 24,
    "idealPhotos": 60
  },
  "musicProfile": {
    "moods": [
      "hopeful",
      "modern",
      "cinematic"
    ],
    "energy": "medium"
  },
  "pacingVariants": [
    {
      "id": "letters",
      "maxEnergy": 0.38,
      "durationMultiplier": 1.12
    },
    {
      "id": "journey",
      "maxEnergy": 0.7,
      "durationMultiplier": 1
    },
    {
      "id": "reunion",
      "maxEnergy": 1,
      "durationMultiplier": 0.85
