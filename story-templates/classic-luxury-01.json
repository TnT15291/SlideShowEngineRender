      "photoSlots": [
        {
          "slot": "film_roll",
          "count": 6,
          "orient": "any",
          "quality": "good",
          "preferVariety": true
        }
      ]
    },
    {
      "id": "s81_portrait_reflection",
      "effect": "portrait_reflection",
