      "durationRole": "calm",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "portrait",
          "quality": "best"
        }
      ]
    },
    {
      "id": "s82_film_roll_right",
      "effect": "film_roll_right",
      "durationRole": "montage",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "film_roll",
          "count": 6,
          "orient": "any",
          "quality": "good",
          "preferVariety": true
        }
      ]
    },
    {
      "id": "s83_gallery_matte",
      "effect": "layer_scene",
      "look": "p2_offset_portrait",
      "durationRole": "normal",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "any",
          "quality": "best"
        }
      ]
    },
    {
      "id": "s84_photo_duo",
      "effect": "layer_scene",
      "look": "p2_overlap_duo",
      "durationRole": "normal",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "back",
          "orient": "any",
          "quality": "good"
        },
        {
          "slot": "front",
          "orient": "any",
          "quality": "best"
        }
      ]
    },
    {
      "id": "s85_feature_duo",
      "effect": "layer_scene",
      "look": "p2_diagonal_trio",
      "durationRole": "normal",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "top",
          "orient": "any",
          "quality": "good"
        },
        {
          "slot": "mid",
          "orient": "any",
          "quality": "best"
        },
        {
          "slot": "low",
          "orient": "any",
          "quality": "good"
        }
      ]
