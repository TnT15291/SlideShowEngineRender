{
  "id": "classic-luxury-01",
  "version": 1,
  "name": "Classic Luxury",
  "tier": "smart_lite",
  "libraryTheme": "dark_film",
  "layoutPresets": {
    "gold_mount": {
      "radius": 0,
      "border": 22,
      "borderColor": "#C9A86A",
      "shadow": true
    }
  },
  "looks": {
    "arch_trio_plate": {
      "intent": "wordless arch trio beat, wearing this recipe's own frame",
      "layout": "arch_trio",
      "frame": "gold_mount",
      "photoTreatment": {
        "saturation": 0.88,
        "contrast": 1.08
      }
    },
    "hero_title_card_mount": {
      "intent": "the hero title card, wearing the recipe's gold_mount frame",
      "layout": "hero_title_card",
      "frame": "gold_mount"
    },
    "three_photo_row_mount": {
      "intent": "the three-photo row, wearing the recipe's gold_mount frame",
      "layout": "three_photo_row",
      "frame": "gold_mount"
    },
    "closing_names_mount": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 130,
            "y": 400
          },
          "date": {
            "sizePx": 36,
            "y": 680
          }
        }
      }
    },
    "p2_offset_portrait": {
      "intent": "Phase 2 adoption of offset_portrait_hero for s83_gallery_matte.",
      "layout": "offset_portrait_hero",
      "frame": "gold_mount",
      "photoTreatment": {
        "saturation": 0.88,
        "contrast": 1.08
      },
      "layoutOverrides": {
        "photoSlots": {
          "hero": {
            "x": 100,
            "y": 80,
            "width": 1240,
            "height": 900
          }
        }
      }
    },
    "p2_overlap_duo": {
      "intent": "Phase 2 adoption of overlap_stack_duo for s84_photo_duo.",
      "layout": "overlap_stack_duo",
      "photoTreatment": {
        "saturation": 0.88,
        "contrast": 1.08
      },
      "layoutOverrides": {
        "photoSlots": {
          "back": {
            "x": 150,
            "width": 930
          },
          "front": {
            "x": 900,
            "y": 420
          }
        }
      }
    },
    "p2_diagonal_trio": {
      "intent": "Phase 2 adoption of diagonal_staircase_trio for s85_feature_duo.",
      "layout": "diagonal_staircase_trio",
      "frame": "gold_mount",
      "photoTreatment": {
        "saturation": 0.88,
        "contrast": 1.08
      },
      "layoutOverrides": {
        "photoSlots": {
          "low": {
            "x": 1190
          }
        }
      }
    }
  },
  "storyArc": {
    "sequence": [
      "arrival",
      "presentation",
      "lineage",
      "memory",
      "celebration",
      "illumination",
      "grace",
      "forever"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_slow",
      "dissolve",
      "fade_to_black",
      "none",
      "fade_grays",
      "distance"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "Formal black-and-gold reception look: symmetrical cards, deliberate holds and an Art Deco finish."
  },
  "intro": {
    "summary": "Phong cách sang trọng cổ điển đen-vàng, đối xứng và trang trọng, phảng phất Art Deco.",
    "photos": "Hợp ảnh lễ cưới/tiệc trang trọng, ảnh nghi thức, không gian sảnh tiệc lộng lẫy; ảnh nên bố cục ngay ngắn, ánh sáng đẹp vì khung hình được giữ lâu.",
    "story": "Dành cho đám cưới hình thức cổ điển, sang trọng — tập trung nghi lễ và tiệc cưới, không cần kể hành trình yêu trước đó.",
    "music": "Hợp nhạc giao hưởng thanh lịch, tiết tấu chậm đến vừa, sang trọng, cổ điển."
  },
  "fit": {
    "bestFor": [
      "formal",
      "ceremony",
      "luxury",
      "reception"
    ],
    "minPhotos": 30,
    "idealPhotos": 65
  },
  "musicProfile": {
    "moods": [
      "elegant",
      "orchestral",
      "cinematic"
    ],
    "energy": "low_to_medium"
  },
  "pacingVariants": [
    {
      "id": "stately",
      "maxEnergy": 0.38,
      "durationMultiplier": 1.15
    },
    {
      "id": "gala",
      "maxEnergy": 0.68,
      "durationMultiplier": 1
    },
    {
      "id": "grand",
      "maxEnergy": 1,
      "durationMultiplier": 0.87
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 5400,
      "saturation": 0.94,
      "contrast": 1.09,
      "grain": 3,
      "vignette": true,
      "glow": 0.04
    },
    "audio": {
      "fade_in": 2,
      "fade_out": 4,
      "crossfade": 0
    },
    "overlays": [
      {
        "path": "overlays/vintage_projector.mp4",
        "position": "fullscreen",
        "opacity": 0.14,
        "blend": "screen",
        "start": 0
      }
    ],
    "fonts": {
      "title": "fonts/AlexBrush-Regular.ttf",
      "heading": "fonts/YesevaOne-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#11100F",
      "ink": "#E8D3A4",
      "brown": "#C5A363",
      "white": "#F8F1E4"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 6.2,
      "calmSceneSec": 8,
      "buildSceneSec": 5,
      "montageSec": 11,
      "closingSec": 9
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "fade_slow",
          "duration": 1
        },
        {
          "type": "fade_grays",
          "duration": 1
        },
        {
          "type": "distance",
          "duration": 0.9
        }
      ],
      "calm": {
        "type": "fade_slow",
        "duration": 1.2
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.8
      },
      "peak": {
        "type": "fade_to_black",
        "duration": 0.7
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 55
    }
  },
  "scenes": [
    {
      "id": "s01_open",
      "effect": "dark_feather",
      "durationRole": "calm",
      "transitionRole": "calm",
      "captionPattern": "{{bride}} & {{groom}}",
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "landscape",
          "quality": "best"
        }
      ]
    },
    {
      "id": "s03b_fly_in_duo",
      "effect": "still",
      "renderer": "remotion",
      "template": "aperture_reveal",
      "signature": true,
      "durationRole": "normal",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "assets",
          "count": 2,
          "orient": "portrait",
          "quality": "best"
        }
      ]
    },
    {
      "id": "s04_hero",
      "effect": "still",
      "renderer": "blender",
      "template": "ring_spin_reveal",
      "signature": true,
      "durationRole": "calm",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "landscape",
          "quality": "best"
        }
      ]
    },
    {
      "id": "s02_title",
      "effect": "layer_scene",
      "durationRole": "calm",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "bg",
          "orient": "landscape",
          "quality": "best"
        },
        {
          "slot": "strip_1",
          "orient": "portrait",
          "quality": "good"
        },
        {
          "slot": "strip_2",
          "orient": "portrait",
          "quality": "good"
        },
        {
          "slot": "strip_3",
          "orient": "portrait",
          "quality": "good"
        }
      ],
      "text": {
        "eyebrow": "Trân trọng",
        "date": "{{date}}"
      },
      "look": "hero_title_card_mount"
    },
    {
      "id": "s03_ceremony",
      "effect": "layer_scene",
      "durationRole": "normal",
      "transitionRole": "memory",
      "photoSlots": [
        {
          "slot": "left",
          "orient": "any",
          "quality": "good"
        },
        {
          "slot": "centre",
          "orient": "any",
          "quality": "best"
        },
        {
          "slot": "right",
          "orient": "any",
          "quality": "good"
        }
      ],
      "text": {
        "heading": [
          "Ngày trọng đại",
          "Ngày hai họ nên duyên"
        ],
        "caption": [
          "Khoảnh khắc hai gia đình cùng chứng kiến một lời hẹn ước.",
          "Giây phút thiêng liêng, có đủ hai bên gia đình chứng kiến."
        ]
      },
      "repeatable": {
        "maxRepeats": 3,
        "variants": [
          {
            "text": {
              "heading": "Lời hẹn ước",
              "caption": "Trước sự chứng kiến của những người thân thương nhất."
            }
          },
          {
            "text": {
              "heading": "Nghi lễ",
              "caption": "Một khoảnh khắc trang trọng mà ấm áp của ngày trọng đại."
            }
          },
          {
            "text": {}
          }
        ]
      },
      "look": "three_photo_row_mount"
    },
    {
      "id": "s55_gallery_trio",
      "effect": "layer_scene",
      "look": "arch_trio_plate",
      "durationRole": "normal",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "left",
          "orient": "portrait",
          "quality": "good"
        },
        {
          "slot": "centre",
          "orient": "portrait",
          "quality": "best"
        },
        {
          "slot": "right",
          "orient": "portrait",
          "quality": "good"
        }
      ]
    },
    {
      "id": "s05_family",
      "effect": "memory_wall",
      "durationRole": "normal",
      "transitionRole": "default",
      "photoSlots": [
        {
          "slot": "memories",
          "count": 6,
          "orient": "any",
          "quality": "good"
        }
      ],
      "captionPattern": [
        "Niềm vui được sẻ chia cùng những người thân yêu.",
        "Hạnh phúc trọn vẹn hơn khi có người thân bên cạnh."
      ],
      "repeatable": {
        "maxRepeats": 3,
        "variants": [
          {
            "captionPattern": "Những gương mặt thân quen làm nên một ngày đáng nhớ."
          },
          {
            "captionPattern": "Bên nhau, niềm hạnh phúc như được nhân lên."
          },
          {
            "captionPattern": ""
          }
        ]
      },
      "params": {
        "background": "#2B2B32"
      }
    },
    {
      "id": "s06_peak",
      "effect": "film_roll_up",
      "durationRole": "montage",
      "transitionRole": "peak",
      "photoSlots": [
        {
          "slot": "film_roll",
          "count": 8,
          "orient": "any",
          "quality": "good"
        }
      ]
    },
    {
      "id": "s06b_stained_glass",
      "effect": "mask_reveal",
      "mask": "assets/masks/stained_glass_reveal.mp4",
      "signature": true,
      "durationRole": "normal",
      "transitionRole": "default",
      "captionPattern": [
        "Như ánh sáng xuyên qua ô kính màu, từng khoảnh khắc đều rực rỡ.",
        "Mỗi khoảnh khắc lấp lánh, như ánh sáng xuyên qua ô kính màu."
      ],
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "landscape",
          "quality": "best"
        }
      ],
      "params": {
        "background": "#2B2B32"
      }
    },
    {
      "id": "s06c_spotlight",
      "effect": "spotlight_focus",
      "signature": true,
      "durationRole": "normal",
      "transitionRole": "default",
      "captionPattern": [
        "Sang trọng không cần phô trương, chỉ cần đúng người, đúng khoảnh khắc.",
        "Không cần phô trương — chỉ cần đúng người, đúng thời khắc."
      ],
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "landscape",
          "quality": "best"
        }
      ]
    },
    {
      "id": "s80_film_roll_up",
      "effect": "film_roll_up",
