  "storyArc": {
    "sequence": [
      "spring",
      "summer",
      "autumn",
      "winter",
      "new_spring",
      "wedding",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "dissolve",
      "fade_slow",
      "crossfade",
      "none",
      "distance"
