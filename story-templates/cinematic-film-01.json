{
  "id": "cinematic-film-01",
  "version": 1,
  "name": "Cinematic Film",
  "tier": "smart_lite",
  "libraryTheme": "dark_film",
  "layoutPresets": {
    "reel_hairline": {
      "radius": 0,
      "border": 3,
      "borderColor": "#8E8B84",
      "shadow": true
    }
  },
  "looks": {
    "title_plate": {
      "intent": "the title card, drained to near-monochrome so it is not another quote beat",
      "layout": "full_bleed_quote",
      "photoTreatment": {
        "saturation": 0.5
      }
    },
    "film_gallery": {
      "intent": "a portrait-safe photograph on a luminous warm matte, cropped to the theme's own 2.39 frame",
      "layout": "gallery_matte_hero",
      "layoutOverrides": {
        "background": {
          "type": "tint",
          "color": "#D8CFC0"
        },
        "photoSlots": {
          "hero": {
            "y": 239,
            "height": 602
          }
        }
      }
    },
    "feature_trio": {
      "intent": "one hero with two stacked beside it — what this beat's id always claimed",
      "layout": "feature_plus_duo",
      "frame": "reel_hairline"
    },
    "collage_cluster_text_reel": {
      "intent": "the photo cluster beside its paragraph, wearing the recipe's reel_hairline frame",
      "layout": "collage_cluster_text",
      "frame": "reel_hairline"
    },
    "paper_collage_reel": {
      "intent": "the layered paper collage, wearing the recipe's reel_hairline frame",
      "layout": "paper_collage",
      "frame": "reel_hairline"
    },
    "full_bleed_quote_reel": {
      "intent": "the full-bleed quote beat — a frame would render nothing over a full bleed, so the type and the grade carry it",
      "layout": "full_bleed_quote",
      "layoutOverrides": {
        "textSlots": {
          "quote": {
            "x": 360,
            "width": 1200,
            "y": 800,
            "height": 200,
            "sizePx": 46
          }
        }
      },
      "photoTreatment": {
        "saturation": 0.82,
        "contrast": 1.1
      }
    },
    "two_photo_story_reel": {
      "intent": "the portrait-and-wide story pair, wearing the recipe's reel_hairline frame",
      "layout": "two_photo_story",
      "frame": "reel_hairline"
    },
    "journey_duo_reel": {
      "intent": "the journey pair, wearing the recipe's reel_hairline frame",
      "layout": "journey_duo",
      "frame": "reel_hairline"
    },
    "photo_duo_reel": {
      "intent": "the bare photo pair, wearing the recipe's reel_hairline frame",
      "layout": "photo_duo",
      "frame": "reel_hairline"
    },
    "arch_trio_reel": {
      "intent": "the arched triptych, wearing the recipe's reel_hairline frame",
      "layout": "arch_trio",
      "frame": "reel_hairline"
    },
    "closing_names_reel": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 108,
            "y": 430
          },
          "date": {
            "sizePx": 32,
            "y": 660
          }
        }
      }
    }
  },
  "storyArc": {
    "sequence": [
      "silhouette",
      "recognition",
      "closeness",
      "tension",
      "belonging",
      "vow",
      "stillness",
      "forever"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_slow",
      "dissolve",
      "smooth_left",
      "none",
      "blur",
      "distance"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 2,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "Moody cinematic documentary / fashion-film look (2026 trend: editorial pacing, intentional color grade, the line between wedding video and fashion film fading). Letterbox + grain + dark scenes. Original recipe."
  },
  "intro": {
    "summary": "Phong cách phim điện ảnh u tịch, tông tối, letterbox và hạt phim — như một bộ phim ngắn hơn là video cưới thông thường.",
    "photos": "Hợp ảnh có ánh sáng kịch tính, tông trầm, ảnh phóng sự chân thật cả ngày cưới; cần lượng ảnh khá lớn (35–70) để giữ nhịp chậm mà vẫn đủ chất liệu.",
    "story": "Kể hành trình tình yêu đầy cảm xúc — gặp gỡ, gắn kết, gia đình, đến cao trào — theo nhịp phim tài liệu chậm rãi, sâu lắng.",
    "music": "Hợp nhạc điện ảnh, giao hưởng nhẹ, cảm xúc và chậm — năng lượng thấp, để hình ảnh dẫn dắt."
  },
  "fit": {
    "bestFor": [
      "cinematic",
      "moody",
      "wedding_day",
      "couple_journey"
    ],
    "minPhotos": 35,
    "idealPhotos": 70
  },
  "musicProfile": {
    "moods": [
      "cinematic",
      "emotional",
      "slow"
    ],
    "energy": "low"
  },
  "pacingVariants": [
    {
      "id": "restrained",
      "maxEnergy": 0.38,
      "durationMultiplier": 1.12
    },
    {
      "id": "cinematic",
      "maxEnergy": 0.68,
      "durationMultiplier": 1
    },
    {
      "id": "trailer",
      "maxEnergy": 1,
      "durationMultiplier": 0.86
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "meetingPlace",
      "yearsTogether",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 5200,
      "saturation": 0.92,
      "contrast": 1.08,
      "grain": 6,
      "letterbox": 2.39,
      "vignette": true,
      "glow": 0.06,
      "lut": "assets/luts/moody_earth_01.cube"
    },
    "audio": {
      "fade_in": 2,
      "fade_out": 3.5,
      "crossfade": 0
    },
    "overlays": [
      {
        "path": "overlays/particles.mp4",
        "position": "fullscreen",
        "opacity": 0.18,
        "blend": "screen",
        "start": 0
      }
    ],
    "fonts": {
      "title": "fonts/AlexBrush-Regular.ttf",
      "heading": "fonts/YesevaOne-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#101010",
      "ink": "#EDE6D8",
      "brown": "#EDE6D8",
      "white": "#EDE6D8"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 6.5,
      "calmSceneSec": 8,
      "buildSceneSec": 5,
      "montageSec": 13,
      "closingSec": 9
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "fade_slow",
          "duration": 1
        },
        {
          "type": "blur",
          "duration": 0.9
        },
        {
          "type": "distance",
          "duration": 1
        }
      ],
      "calm": {
        "type": "fade_slow",
        "duration": 1.1
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.8
      },
      "peak": {
        "type": "smooth_left",
        "duration": 0.5
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore",
        "skinFrac"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 45
    }
  },
