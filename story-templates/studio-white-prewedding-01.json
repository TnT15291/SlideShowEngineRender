        "photoSlots": {
          "hero": {
            "x": 190,
            "y": 120,
            "width": 1240,
            "height": 900
          }
        }
      }
    },
    "p2_golden_pair": {
      "intent": "Phase 2 adoption of golden_column_pair for s84_photo_duo.",
      "layout": "golden_column_pair",
      "frame": "studio_hairline",
