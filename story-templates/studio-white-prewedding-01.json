  "storyArc": {
    "sequence": [
      "title",
      "establish",
      "portraits",
      "couple",
      "gallery",
      "turn",
      "build",
      "peak",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_slow",
      "dissolve",
      "fade_to_white",
      "crossfade",
      "none",
      "reveal_right"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 2,
      "peak": 1
    }
  },
  "source": {
    "origin": "reference_adaptation",
    "url": "https://www.youtube.com/watch?v=VyQ9yOcp0m0",
    "title": "Pre-Wedding Le Quang - Loan Anh - STT260620.mp4",
    "notes": "Adapted from the reference video's bright studio slideshow language: centered portrait cards, soft enlarged background echoes, white-flash dissolves, triptychs, page turns and floating gallery motion. It recreates the visual grammar with engine-native effects rather than copying source media."
  },
  "intro": {
    "summary": "Ngôn ngữ slideshow studio sáng trắng — thẻ chân dung, hiệu ứng trắng lóa, tam liên ảnh và trang lật.",
    "photos": "Hợp bộ ảnh chân dung studio prewedding (portrait-heavy), tông sáng, nền đơn giản; không cần ảnh phóng sự.",
    "story": "Phù hợp video prewedding thuần túy, giới thiệu vẻ đẹp cặp đôi qua các concept chụp studio, không kể hành trình yêu hay ngày cưới.",
    "music": "Hợp nhạc piano-pop lãng mạn, nhẹ nhàng, tiết tấu chậm đến vừa."
  },
  "fit": {
    "bestFor": [
      "pre_wedding",
      "studio",
      "portrait_heavy",
      "white_wedding",
      "minimal",
      "romantic"
    ],
    "minPhotos": 24,
    "idealPhotos": 48
