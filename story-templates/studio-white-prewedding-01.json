      "borderColor": "#DAD3C9",
      "shadow": false
    }
  },
  "looks": {
    "gallery_matte_plate": {
      "intent": "wordless gallery matte beat, wearing this recipe's own frame",
      "layout": "gallery_matte_hero",
      "frame": "studio_hairline"
    },
    "full_bleed_quote_studio": {
      "intent": "the full-bleed quote beat — a frame would render nothing over a full bleed, so the type and the grade carry it",
      "layout": "full_bleed_quote",
      "layoutOverrides": {
        "textSlots": {
          "quote": {
            "sizePx": 48,
            "y": 822,
            "height": 180
          }
        }
      },
      "photoTreatment": {
        "saturation": 0.92,
        "brightness": 0.03
      }
    },
    "polaroid_feature_studio": {
      "intent": "the single featured print, wearing the recipe's studio_hairline frame",
      "layout": "polaroid_feature",
      "frame": "studio_hairline"
    },
    "text_left_photo_right_studio": {
      "intent": "the text-left spread, wearing the recipe's studio_hairline frame",
      "layout": "text_left_photo_right",
      "frame": "studio_hairline"
    },
    "magazine_page_turn_studio": {
      "intent": "the magazine page turn, wearing the recipe's studio_hairline frame",
      "layout": "magazine_page_turn",
      "frame": "studio_hairline"
    },
    "closing_names_studio": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 112,
            "y": 415
          },
          "date": {
            "sizePx": 30,
            "y": 665
          }
        }
      }
    },
