{
  "id": "garden-botanical-01",
  "version": 1,
  "name": "Garden Botanical",
  "tier": "smart_lite",
  "libraryTheme": "modern_teal",
  "layoutPresets": {
    "arbour_arch": {
      "radius": 120,
      "border": 7,
      "borderColor": "#B8C79C",
      "shadow": false
    }
  },
  "looks": {
    "gallery_matte_plate": {
      "intent": "wordless gallery matte beat, wearing this recipe's own frame",
      "layout": "gallery_matte_hero",
      "frame": "arbour_arch"
    },
    "duo_tinted_spread_plate": {
      "intent": "wordless duo tinted spread beat, wearing this recipe's own frame",
      "layout": "duo_tinted_spread",
      "frame": "arbour_arch"
    },
    "feature_plus_duo_plate": {
      "intent": "wordless feature plus duo beat, wearing this recipe's own frame",
      "layout": "feature_plus_duo",
      "frame": "arbour_arch"
    },
    "full_bleed_quote_arbour": {
      "intent": "the full-bleed quote beat — a frame would render nothing over a full bleed, so the type and the grade carry it",
      "layout": "full_bleed_quote",
      "layoutOverrides": {
        "textSlots": {
          "quote": {
            "sizePx": 56,
            "y": 804,
            "height": 200
          }
        }
      },
      "photoTreatment": {
        "saturation": 1.06
      }
    },
    "collage_cluster_text_arbour": {
      "intent": "the photo cluster beside its paragraph, wearing the recipe's arbour_arch frame",
      "layout": "collage_cluster_text",
      "frame": "arbour_arch"
    },
    "paper_collage_arbour": {
      "intent": "the layered paper collage, wearing the recipe's arbour_arch frame",
      "layout": "paper_collage",
      "frame": "arbour_arch"
    },
    "three_photo_row_arbour": {
      "intent": "the three-photo row, wearing the recipe's arbour_arch frame",
      "layout": "three_photo_row",
      "frame": "arbour_arch"
    },
    "closing_names_arbour": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 128,
            "y": 400
          },
          "date": {
            "sizePx": 36,
            "y": 660
          }
        }
      }
    }
  },
  "storyArc": {
    "sequence": [
      "bloom",
      "morning",
      "gathering",
      "bond",
      "blossom",
      "joy",
      "wonder",
      "forever"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "crossfade",
      "dissolve",
      "smooth_up",
      "none",
      "wipe_up"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "Outdoor garden wedding: botanical framing, natural greens, documentary groups and a floral interlude."
  },
  "intro": {
    "summary": "Đám cưới ngoài trời trong vườn — khung hình hoa lá, mảng xanh tự nhiên và không khí gia đình ấm áp.",
    "photos": "Hợp ảnh cưới ngoài trời/trong vườn nhiều cây xanh, ảnh nhóm gia đình tự nhiên (phóng sự), xen ảnh hoa lá cận cảnh.",
    "story": "Phù hợp lễ cưới tổ chức tại không gian vườn/ngoài trời, muốn giữ không khí tự nhiên, gần gũi gia đình.",
    "music": "Hợp nhạc acoustic, ấm áp, dần tươi sáng, tiết tấu chậm đến vừa."
  },
  "fit": {
    "bestFor": [
      "outdoor",
      "garden",
      "family_warmth",
      "wedding_day"
    ],
    "minPhotos": 32,
    "idealPhotos": 70
  },
  "musicProfile": {
    "moods": [
      "acoustic",
      "warm",
      "uplifting"
    ],
    "energy": "low_to_medium"
  },
  "pacingVariants": [
    {
      "id": "meadow",
      "maxEnergy": 0.38,
      "durationMultiplier": 1.12
    },
    {
      "id": "garden",
      "maxEnergy": 0.68,
      "durationMultiplier": 1
    },
    {
      "id": "celebration",
      "maxEnergy": 1,
      "durationMultiplier": 0.86
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 5700,
      "saturation": 1.01,
      "contrast": 1.02,
      "glow": 0.08
    },
    "audio": {
      "fade_in": 1.5,
      "fade_out": 3,
      "crossfade": 0
    },
    "overlays": [
      {
        "path": "overlays/floral_frame_animation.mp4",
        "position": "fullscreen",
        "opacity": 0.16,
        "blend": "screen",
        "start": 0
      }
    ],
    "fonts": {
      "title": "fonts/JosefinSans-Regular.ttf",
      "heading": "fonts/Montserrat-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#F2F1E8",
      "ink": "#253B32",
      "brown": "#65705A",
      "white": "#FFFFFF"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 5.8,
      "calmSceneSec": 7.2,
      "buildSceneSec": 4.6,
      "montageSec": 11,
      "closingSec": 8
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "crossfade",
          "duration": 0.8
        },
        {
          "type": "dissolve",
          "duration": 0.9
        },
        {
          "type": "wipe_up",
          "duration": 0.7
        }
      ],
      "calm": {
        "type": "dissolve",
        "duration": 1
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.8
      },
      "peak": {
        "type": "smooth_up",
        "duration": 0.5
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "groupScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 70
    }
  },
