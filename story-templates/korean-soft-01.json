{
  "id": "korean-soft-01",
  "version": 1,
  "name": "Korean Soft",
  "tier": "smart_lite",
  "libraryTheme": "white_weddings",
  "layoutPresets": {
    "soft_round": {
      "radius": 56,
      "border": 0,
      "shadow": true
    }
  },
  "looks": {
    "text_left_photo_right_soft": {
      "intent": "the text-left spread, wearing the recipe's soft_round frame",
      "layout": "text_left_photo_right",
      "frame": "soft_round"
    },
    "two_photo_story_soft": {
      "intent": "the portrait-and-wide story pair, wearing the recipe's soft_round frame",
      "layout": "two_photo_story",
      "frame": "soft_round"
    },
    "full_bleed_quote_soft": {
      "intent": "the full-bleed quote beat — a frame would render nothing over a full bleed, so the type and the grade carry it",
      "layout": "full_bleed_quote",
      "layoutOverrides": {
        "textSlots": {
          "quote": {
            "sizePx": 50,
            "y": 820,
            "height": 182
          }
        }
      },
      "photoTreatment": {
        "saturation": 0.94,
        "brightness": 0.03
      }
    },
    "photo_left_text_right_soft": {
      "intent": "the photo-left spread, wearing the recipe's soft_round frame",
      "layout": "photo_left_text_right",
      "frame": "soft_round"
    },
    "closing_names_soft": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 118,
            "y": 410
          },
          "date": {
            "sizePx": 32,
            "y": 660
          }
        }
      }
    },
    "p2_offset_portrait": {
      "intent": "Phase 2 adoption of offset_portrait_hero for s83_gallery_matte.",
      "layout": "offset_portrait_hero",
      "frame": "soft_round",
      "layoutOverrides": {
        "photoSlots": {
          "hero": {
            "x": 170,
            "y": 100,
            "width": 1240,
            "height": 900
          }
        }
      }
    },
    "p2_golden_pair": {
      "intent": "Phase 2 adoption of golden_column_pair for s84_photo_duo.",
      "layout": "golden_column_pair",
      "frame": "soft_round",
      "layoutOverrides": {
        "photoSlots": {
          "major": {
            "x": 80,
            "width": 1070
          },
          "minor": {
            "x": 1220,
            "y": 270,
            "height": 550
          }
        }
      }
    },
    "p2_circle_trio": {
      "intent": "Phase 2 adoption of circle_trio_stagger for s85_arch_trio.",
      "layout": "circle_trio_stagger",
      "layoutOverrides": {
        "photoSlots": {
          "p2": {
            "y": 310
          }
        }
      }
    }
  },
  "storyArc": {
    "sequence": [
      "glow",
      "gaze",
      "gentle",
      "whisper",
      "warmth",
      "radiance",
      "tenderness",
      "forever"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "crossfade",
      "fade_slow",
      "dissolve",
      "none",
      "fade_to_white"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "Bright Korean studio romance: airy whites, portrait-led cards, restrained motion and generous breathing room."
  },
  "intro": {
    "summary": "Phong cách studio Hàn Quốc tươi sáng — tông trắng nhẹ nhàng, nhịp chậm rãi, nhiều khoảng lặng.",
    "photos": "Hợp bộ ảnh chân dung studio phong cách Hàn (tông sáng, nền trắng/pastel), ảnh mềm mại, ít ảnh phóng sự đời thường.",
    "story": "Phù hợp video prewedding studio, không cần kể hành trình tình yêu chi tiết — tôn vinh vẻ đẹp và sự lãng mạn của cặp đôi.",
    "music": "Hợp nhạc piano nhẹ nhàng, lãng mạn, tiết tấu rất chậm, sâu lắng."
  },
  "fit": {
    "bestFor": [
      "soft_romance",
      "studio",
      "portrait_heavy",
      "prewedding"
    ],
    "minPhotos": 24,
    "idealPhotos": 50
  },
  "musicProfile": {
    "moods": [
      "soft",
      "romantic",
      "piano"
    ],
    "energy": "low"
  },
  "pacingVariants": [
    {
      "id": "airy",
      "maxEnergy": 0.38,
      "durationMultiplier": 1.14
    },
    {
      "id": "romance",
      "maxEnergy": 0.68,
      "durationMultiplier": 1
    },
    {
      "id": "bright",
      "maxEnergy": 1,
      "durationMultiplier": 0.88
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 5900,
      "saturation": 0.96,
      "contrast": 0.98,
      "brightness": 0.03,
      "glow": 0.08
    },
    "audio": {
      "fade_in": 2,
      "fade_out": 3,
      "crossfade": 0
    },
    "overlays": [],
    "fonts": {
      "title": "fonts/Allura-Regular.ttf",
      "heading": "fonts/CormorantGaramond-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#FAF7F4",
      "ink": "#403A3C",
      "brown": "#8A7478",
      "white": "#FFFFFF"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 6,
      "calmSceneSec": 7.5,
      "buildSceneSec": 4.8,
      "montageSec": 10,
      "closingSec": 8
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "crossfade",
          "duration": 0.8
        },
        {
          "type": "fade_to_white",
          "duration": 0.7
        },
        {
          "type": "dissolve",
          "duration": 0.85
        }
      ],
      "calm": {
        "type": "fade_slow",
        "duration": 1
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.7
      },
      "peak": {
        "type": "fade_slow",
        "duration": 0.8
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "skinFrac"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 85
    }
  },
  "scenes": [
    {
      "id": "s01_open",
      "effect": "layer_scene",
      "durationRole": "calm",
      "transitionRole": "calm",
      "photoSlots": [
        {
          "slot": "photo",
          "orient": "portrait",
          "quality": "best"
        }
      ],
      "text": {
        "heading": "{{bride}} & {{groom}}",
        "body": [
          "Một câu chuyện dịu dàng, bắt đầu từ hai người.",
          "Một câu chuyện nhẹ nhàng, chỉ thuộc về hai người."
        ]
      },
      "look": "text_left_photo_right_soft"
    },
    {
      "id": "s02_portrait",
      "effect": "portrait_reflection",
      "signature": true,
      "durationRole": "calm",
      "transitionRole": "default",
      "captionPattern": [
        "Cứ để ánh nhìn ấy nói thay mọi lời.",
        "Chỉ một ánh nhìn, đã đủ để hiểu hết."
      ],
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "portrait",
          "quality": "best"
        }
      ]
    },
    {
      "id": "s03_pair",
      "effect": "layer_scene",
      "durationRole": "normal",
      "transitionRole": "memory",
      "photoSlots": [
        {
          "slot": "portrait",
          "orient": "portrait",
          "quality": "best"
        },
        {
          "slot": "wide",
          "orient": "landscape",
          "quality": "good"
        }
      ],
      "text": {
        "body": [
          "Từ những điều rất nhỏ, mình dần trở thành bình yên của nhau.",
          "Từng điều nhỏ bé, dần dà lại thành chốn bình yên của nhau."
        ]
      },
      "repeatable": {
        "maxRepeats": 3,
        "variants": [
          {
            "text": {
              "body": "Bình yên là điều mình tìm thấy ở nhau."
            }
          },
          {
            "text": {
              "body": "Những điều giản dị hóa ra lại quý giá nhất."
            }
          },
          {
            "text": {}
          }
        ]
      },
      "look": "two_photo_story_soft"
    },
    {
      "id": "s04_quote",
