        "maxRepeats": 3,
        "variants": [
          {
            "text": {
              "quote": "Yêu thương đôi khi chỉ là ở lại, thật lâu."
            }
          },
          {
            "text": {
              "quote": "Hạnh phúc là được là chính mình bên nhau."
