{
  "id": "garden-diary-01",
  "version": 1,
  "name": "Garden Diary",
  "tier": "smart_lite",
  "libraryTheme": "white_weddings",
  "layoutPresets": {
    "diary_tape": {
      "radius": 4,
      "border": 18,
      "borderColor": "#EFE4D2",
      "shadow": false
    }
  },
  "looks": {
    "arch_trio_plate": {
      "intent": "wordless arch trio beat, wearing this recipe's own frame",
      "layout": "arch_trio",
      "frame": "diary_tape"
    },
    "save_date_card_diary": {
      "intent": "the floating save-the-date card, wearing the recipe's diary_tape frame",
      "layout": "save_date_card",
      "frame": "diary_tape"
    },
    "journey_duo_diary": {
      "intent": "the journey pair, wearing the recipe's diary_tape frame",
      "layout": "journey_duo",
      "frame": "diary_tape"
    },
    "photo_duo_diary": {
      "intent": "the bare photo pair, wearing the recipe's diary_tape frame",
      "layout": "photo_duo",
      "frame": "diary_tape"
    },
    "paper_collage_diary": {
      "intent": "the layered paper collage, wearing the recipe's diary_tape frame",
      "layout": "paper_collage",
      "frame": "diary_tape"
    },
    "closing_names_diary": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 122,
            "y": 405
          },
          "date": {
            "sizePx": 34,
            "y": 655
          }
        }
      }
    },
    "p2_offset_portrait": {
      "intent": "Phase 2 adoption of offset_portrait_hero for s83_gallery_matte.",
      "layout": "offset_portrait_hero",
      "frame": "diary_tape",
      "layoutOverrides": {
        "photoSlots": {
          "hero": {
            "x": 100,
            "y": 100,
            "width": 1240,
            "height": 900
          }
        }
      }
    },
    "p2_inset_card": {
      "intent": "Phase 2 adoption of inset_card_hero for s84_photo_duo.",
      "layout": "inset_card_hero",
      "layoutOverrides": {
        "photoSlots": {
          "inset": {
            "x": 1220,
            "y": 610,
            "width": 500,
            "height": 380
          }
        }
      }
    },
    "p2_diagonal_trio": {
      "intent": "Phase 2 adoption of diagonal_staircase_trio for s85_feature_duo.",
      "layout": "diagonal_staircase_trio",
      "frame": "diary_tape",
      "layoutOverrides": {
        "photoSlots": {
          "low": {
            "x": 1190,
            "y": 530
          }
        }
      }
    }
  },
  "storyArc": {
    "sequence": [
      "morning",
      "portraits",
      "details",
      "promenade",
      "vows",
      "golden_hour",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_slow",
      "dissolve",
      "crossfade",
      "none",
      "reveal_up"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 2,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "A botanical daybook inspired by White Weddings' warm ivory pages, but organized around garden light from morning preparation to golden hour."
  },
  "intro": {
    "summary": "Một cuốn nhật ký vườn hoa màu ngà ấm — theo ánh sáng từ sáng sớm chuẩn bị đến giờ vàng.",
    "photos": "Hợp ảnh chụp ngoài trời ánh sáng tự nhiên đẹp — từ ảnh chuẩn bị buổi sáng, ảnh chi tiết (nhẫn, hoa, váy), ảnh dạo bước, đến ảnh giờ vàng.",
    "story": "Phù hợp phóng sự cưới theo trình tự thời gian trong một ngày — sáng chuẩn bị, dạo bước, lời thề, đến khoảnh khắc giờ vàng.",
    "music": "Hợp nhạc acoustic nhẹ nhàng, lãng mạn, tiết tấu chậm đến vừa."
  },
  "fit": {
    "bestFor": [
      "garden",
      "outdoor",
      "botanical",
      "daylight",
      "white_wedding"
    ],
    "minPhotos": 24,
    "idealPhotos": 58
  },
  "musicProfile": {
    "moods": [
      "acoustic",
      "gentle",
      "romantic"
    ],
    "energy": "low_to_medium"
  },
  "pacingVariants": [
    {
      "id": "dew",
      "maxEnergy": 0.35,
      "durationMultiplier": 1.16
    },
    {
      "id": "garden",
      "maxEnergy": 0.68,
      "durationMultiplier": 1
    },
    {
      "id": "sunlight",
      "maxEnergy": 1,
      "durationMultiplier": 0.87
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 5700,
      "saturation": 1.06,
      "contrast": 1.02,
      "glow": 0.12,
      "grain": 1
    },
    "audio": {
      "fade_in": 2,
      "fade_out": 3.5,
      "crossfade": 0
    },
    "overlays": [],
    "fonts": {
      "title": "fonts/Allura-Regular.ttf",
      "heading": "fonts/CormorantGaramond-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#FBF6ED",
      "ink": "#2D2D33",
      "brown": "#71805D",
      "white": "#FFFDFC"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 5.8,
      "calmSceneSec": 7.4,
      "buildSceneSec": 4.6,
      "montageSec": 10,
      "closingSec": 8.5
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "dissolve",
          "duration": 0.8
        },
        {
          "type": "fade_slow",
          "duration": 0.85
        },
        {
          "type": "reveal_up",
          "duration": 0.7
        }
      ],
      "calm": {
        "type": "fade_slow",
        "duration": 1.1
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.9
      },
      "peak": {
        "type": "crossfade",
        "duration": 0.55
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 75
    }
  },
