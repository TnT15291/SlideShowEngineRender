    "transitionStrategy": {
      "default": [
        {
          "type": "dissolve",
          "duration": 0.85
        },
        {
          "type": "fade_slow",
          "duration": 0.9
        },
        {
          "type": "blur",
          "duration": 0.8
        }
      ],
      "calm": {
        "type": "fade_slow",
        "duration": 1.1
      },
      "memory": {
        "type": "dissolve",
        "duration": 1
      },
      "peak": {
        "type": "crossfade",
        "duration": 0.6
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 65
    }
  },
