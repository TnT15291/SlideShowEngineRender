  "storyArc": {
    "sequence": [
      "roots",
      "bride_family",
      "groom_family",
      "two_families",
      "blessing",
      "wedding",
      "legacy",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_slow",
      "dissolve",
      "crossfade",
      "none",
      "blur"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 2,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "A family-forward wedding story that gives parents, grandparents, childhood archives and the joining of two households equal emotional weight."
  },
  "intro": {
    "summary": "Câu chuyện lấy gia đình làm trung tâm — ông bà, cha mẹ, ký ức tuổi thơ và sự hòa quyện hai gia đình.",
    "photos": "Cần nhiều ảnh gia đình, ảnh tư liệu cũ (thời thơ ấu, cha mẹ/ông bà) bên cạnh ảnh cưới — số lượng ảnh nên rộng rãi (23–75) để đủ chỗ cho cả hai nhánh gia đình.",
    "story": "Phù hợp khi gia đình hai bên đóng vai trò quan trọng, muốn tôn vinh cội nguồn và sự gắn kết hai họ, không chỉ riêng cặp đôi.",
    "music": "Hợp nhạc ấm áp, hoài niệm, giao hưởng nhẹ, tiết tấu chậm đến vừa."
  },
  "fit": {
    "bestFor": [
      "family_archive",
      "traditional",
      "multi_generation",
      "ceremony"
    ],
    "minPhotos": 23,
    "idealPhotos": 75
  },
  "musicProfile": {
    "moods": [
      "warm",
      "nostalgic",
      "orchestral"
    ],
    "energy": "low_to_medium"
  },
  "pacingVariants": [
    {
      "id": "ancestry",
      "maxEnergy": 0.38,
      "durationMultiplier": 1.18
    },
    {
      "id": "family",
      "maxEnergy": 0.68,
      "durationMultiplier": 1
    },
    {
      "id": "celebration",
      "maxEnergy": 1,
      "durationMultiplier": 0.87
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
