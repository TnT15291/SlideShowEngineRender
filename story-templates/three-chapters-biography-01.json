{
  "id": "three-chapters-biography-01",
  "version": 1,
  "name": "Three Chapters · Two Lives, One Story",
  "tier": "smart_lite",
  "libraryTheme": "white_weddings",
  "storyArc": {
    "sequence": [
      "bride_biography",
      "groom_biography",
      "meeting",
      "connection",
      "proposal",
      "ceremony",
      "celebration",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "fade_slow",
      "dissolve",
      "crossfade",
      "none",
      "circle_open"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 2,
      "peak": 1
    }
  },
  "source": {
    "origin": "original",
    "notes": "A clearly divided three-act wedding biography: two individual lives, the relationship, then the wedding day; visually informed by White Weddings' ivory editorial restraint."
  },
  "intro": {
    "summary": "Tiểu sử cưới chia ba hồi rõ ràng: hai cuộc đời riêng, chuyện tình, rồi ngày cưới.",
    "photos": "Cần ảnh từ nhiều giai đoạn cuộc đời mỗi người (thời nhỏ, trưởng thành) cộng ảnh hẹn hò và ảnh cưới — lượng ảnh khá lớn (28–70) để đủ kể ba chương.",
    "story": "Phù hợp cặp đôi muốn kể đầy đủ: mỗi người trước khi gặp nhau → chuyện tình → ngày cưới — như một cuốn tiểu sử song hành.",
    "music": "Hợp nhạc piano tự sự, lãng mạn, tiết tấu chậm đến vừa."
  },
  "fit": {
    "bestFor": [
      "biography",
      "love_story",
      "full_wedding",
      "family_archive"
    ],
    "minPhotos": 28,
    "idealPhotos": 70
  },
  "musicProfile": {
    "moods": [
      "romantic",
      "narrative",
      "piano"
    ],
    "energy": "low_to_medium"
  },
  "pacingVariants": [
    {
      "id": "memoir",
      "maxEnergy": 0.38,
      "durationMultiplier": 1.16
    },
    {
      "id": "story",
      "maxEnergy": 0.7,
      "durationMultiplier": 1
    },
    {
      "id": "highlights",
      "maxEnergy": 1,
      "durationMultiplier": 0.86
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "meetingPlace",
      "yearsTogether",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "temperature": 5600,
      "saturation": 1.02,
      "contrast": 1.03,
      "glow": 0.08,
      "grain": 1
    },
    "audio": {
      "fade_in": 2,
      "fade_out": 3.5,
      "crossfade": 0
    },
    "overlays": [],
    "fonts": {
      "title": "fonts/Allura-Regular.ttf",
      "heading": "fonts/CormorantGaramond-Regular.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#FBF6ED",
      "ink": "#2D2D33",
      "brown": "#806B50",
      "white": "#FFFDFC"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 5.8,
      "calmSceneSec": 7.5,
      "buildSceneSec": 4.8,
      "montageSec": 10,
      "closingSec": 8.5
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "dissolve",
          "duration": 0.8
        },
        {
          "type": "fade_slow",
          "duration": 0.85
        },
        {
          "type": "circle_open",
          "duration": 0.65
        }
      ],
      "calm": {
        "type": "fade_slow",
        "duration": 1.1
      },
      "memory": {
        "type": "dissolve",
        "duration": 0.9
      },
      "peak": {
        "type": "crossfade",
        "duration": 0.55
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "heroScore",
        "emotionScore"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 72
    }
  },
