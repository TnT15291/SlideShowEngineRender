{
  "id": "afterparty-pulse-01",
  "version": 1,
  "name": "Afterparty Pulse",
  "tier": "smart_lite",
  "libraryTheme": "teal_orange_editorial",
  "layoutPresets": {
    "pulse_edge": {
      "radius": 0,
      "border": 10,
      "borderColor": "#D96F32",
      "shadow": true
    }
  },
  "looks": {
    "arch_trio_plate": {
      "intent": "wordless arch trio beat, wearing this recipe's own frame",
      "layout": "arch_trio",
      "frame": "pulse_edge"
    },
    "three_photo_row_pulse": {
      "intent": "the three-photo row, wearing the recipe's pulse_edge frame",
      "layout": "three_photo_row",
      "frame": "pulse_edge"
    },
    "duo_tinted_spread_pulse": {
      "intent": "the tinted two-photo spread, wearing the recipe's pulse_edge frame",
      "layout": "duo_tinted_spread",
      "frame": "pulse_edge"
    },
    "masonry_grid_wall_pulse": {
      "intent": "the masonry wall, wearing the recipe's pulse_edge frame",
      "layout": "masonry_grid_wall",
      "frame": "pulse_edge"
    },
    "full_bleed_quote_pulse": {
      "intent": "the full-bleed quote beat — a frame would render nothing over a full bleed, so the type and the grade carry it",
      "layout": "full_bleed_quote",
      "layoutOverrides": {
        "textSlots": {
          "quote": {
            "sizePx": 66,
            "y": 786,
            "height": 220
          }
        }
      },
      "photoTreatment": {
        "contrast": 1.08,
        "saturation": 1.06
      }
    },
    "closing_names_pulse": {
      "intent": "the closing card, set in this recipe's own type scale",
      "layout": "closing_names",
      "layoutOverrides": {
        "textSlots": {
          "names": {
            "sizePx": 120,
            "y": 400
          },
          "date": {
            "sizePx": 44,
            "y": 660
          }
        }
      }
    },
    "p2_offset_portrait": {
      "intent": "Phase 2 adoption of offset_portrait_hero for s83_gallery_matte.",
      "layout": "offset_portrait_hero",
      "frame": "pulse_edge",
      "layoutOverrides": {
        "photoSlots": {
          "hero": {
            "x": 160,
            "y": 60,
            "width": 1240,
            "height": 900
          }
        }
      }
    },
    "p2_overlap_duo": {
      "intent": "Phase 2 adoption of overlap_stack_duo for s84_photo_duo.",
      "layout": "overlap_stack_duo",
      "layoutOverrides": {
        "photoSlots": {
          "front": {
            "x": 900,
            "y": 450,
            "rotation": -5
          }
        }
      }
    },
    "p2_stacked_horizon": {
      "intent": "Phase 2 adoption of stacked_horizon_trio for s03_dinner.",
      "layout": "stacked_horizon_trio",
      "frame": "pulse_edge",
      "layoutOverrides": {
        "photoSlots": {
          "band2": {
            "x": 540
          }
        }
      }
    }
  },
  "storyArc": {
    "sequence": [
      "entrance",
      "toast",
      "dinner",
      "first_dance",
      "dancefloor",
      "friends",
      "last_song",
      "closing"
    ]
  },
  "transitionGrammar": {
    "vocabulary": [
      "crossfade",
      "smooth_left",
      "fade_to_black",
      "none",
      "smooth_up",
      "wipe_right"
    ],
    "specialRoles": [
      "memory",
      "peak"
    ],
    "limits": {
      "memory": 1,
      "peak": 2
    }
  },
  "source": {
    "origin": "original",
    "notes": "A reception-only template designed around toasts, first dance and escalating dance-floor energy, ending on a quiet last-song epilogue."
  },
  "intro": {
    "summary": "Video riêng cho phần tiệc — từ lời chúc mở tiệc đến sàn nhảy bùng nổ và khép lại nhẹ nhàng.",
    "photos": "Hợp ảnh/khoảnh khắc tiệc cưới: nâng ly, tiệc tối, sàn nhảy, bạn bè hò reo — không cần ảnh lễ cưới hay ảnh cưới hỏi trang trọng.",
    "story": "Dành cho đám cưới có phần tiệc tối sôi động, muốn kể câu chuyện từ lúc khách vào tiệc đến cao trào nhảy múa rồi lắng lại ở cuối.",
    "music": "Hợp nhạc funk/pop sôi động, năng lượng cao, dồn dập, chỉ chậm lại ở đoạn kết."
  },
  "fit": {
    "bestFor": [
      "reception_only",
      "party",
      "night",
      "friends",
      "dancefloor"
    ],
    "minPhotos": 25,
    "idealPhotos": 65
  },
  "musicProfile": {
    "moods": [
      "funk",
      "pop",
      "celebratory",
      "dance"
    ],
    "energy": "high"
  },
  "pacingVariants": [
    {
      "id": "cocktail",
      "maxEnergy": 0.45,
      "durationMultiplier": 1.08
    },
    {
      "id": "reception",
      "maxEnergy": 0.75,
      "durationMultiplier": 1
    },
    {
      "id": "dancefloor",
      "maxEnergy": 1,
      "durationMultiplier": 0.76
    }
  ],
  "briefFields": {
    "required": [
      "bride",
      "groom"
    ],
    "optional": [
      "date",
      "location",
      "thankYouLine"
    ]
  },
  "defaults": {
    "project": {
      "width": 1920,
      "height": 1080,
      "fps": 30,
      "quality": "share"
    },
    "color": {
      "lut": "assets/luts/teal_orange_01.cube",
      "contrast": 1.08,
      "saturation": 1.08,
      "grain": 3,
      "glow": 0.08
    },
    "audio": {
      "fade_in": 1,
      "fade_out": 3.5,
      "crossfade": 0
    },
    "overlays": [
      {
        "path": "overlays/light_sweep.mp4",
        "position": "fullscreen",
        "opacity": 0.16,
        "blend": "screen",
        "start": 0
      }
    ],
    "fonts": {
      "title": "fonts/AlexBrush-Regular.ttf",
      "heading": "fonts/PlayfairDisplay.ttf",
      "body": "fonts/BeVietnamPro-Regular.ttf"
    },
    "palette": {
      "cream": "#12191C",
      "ink": "#F2EFE9",
      "brown": "#D96F32",
      "white": "#FBFCFB"
    }
  },
  "timelineRules": {
    "durationStrategy": {
      "baseSceneSec": 4.2,
      "calmSceneSec": 6,
      "buildSceneSec": 3.3,
      "montageSec": 8.5,
      "closingSec": 7.5
    },
    "transitionStrategy": {
      "default": [
        {
          "type": "crossfade",
          "duration": 0.35
        },
        {
          "type": "smooth_up",
          "duration": 0.3
        },
        {
          "type": "wipe_right",
          "duration": 0.3
        }
      ],
      "calm": {
        "type": "crossfade",
        "duration": 0.6
      },
      "memory": {
        "type": "fade_to_black",
        "duration": 0.55
      },
      "peak": {
        "type": "smooth_left",
        "duration": 0.25
      },
      "final": {
        "type": "none",
        "duration": 0
      }
    },
    "photoSelection": {
      "reusePolicy": "avoid_until_exhausted",
      "heroPriority": [
        "qualityNorm",
        "emotionScore",
        "sharpness"
      ],
      "fallbackPriority": [
        "qualityNorm",
        "sharpness",
        "meanLuma"
      ],
      "darkPhotoMaxMeanLuma": 52
    }
  },
  "scenes": [
    {
      "id": "s01_entrance",
      "effect": "moving_background_echo",
      "signature": true,
      "durationRole": "build",
      "transitionRole": "calm",
      "photoSlots": [
        {
          "slot": "hero",
          "orient": "portrait",
          "quality": "best"
        }
      ],
      "captionPattern": [
        "WELCOME TO THE PARTY",
        "LET THE NIGHT BEGIN"
      ]
    },
    {
      "id": "s02_toasts",
      "effect": "layer_scene",
      "durationRole": "normal",
      "transitionRole": "memory",
      "photoSlots": [
        {
          "slot": "left",
          "orient": "any",
          "quality": "good"
        },
        {
          "slot": "centre",
          "orient": "any",
          "quality": "best"
        },
        {
          "slot": "right",
          "orient": "any",
          "quality": "good"
        }
      ],
      "text": {
        "heading": [
          "CHEERS!",
          "TO US"
        ],
        "caption": [
          "Nâng ly, chúc mừng cô dâu chú rể giữa những người thân yêu nhất.",
          "Lời chúc chân thành nhất, giữa vòng tay người thân."
        ]
      },
      "repeatable": {
        "maxRepeats": 3,
        "variants": [
          {
            "text": {
              "heading": "Nâng ly",
              "caption": "Từng lời chúc, từng nụ cười — tất cả đều là yêu thương gửi trao."
            }
          },
          {
            "text": {
              "heading": "Chúc mừng",
              "caption": "Bạn bè, gia đình cùng nâng ly cho một khởi đầu mới."
            }
          }
        ]
      },
      "look": "three_photo_row_pulse"
    },
    {
      "id": "s02c_cheers_duo",
      "effect": "layer_scene",
      "durationRole": "normal",
      "transitionRole": "default",
